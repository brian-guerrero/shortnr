---
import { BASE_URL } from "../config";

interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  ogType?: string;
  pubDate?: string;
}

const { title, description, canonical, ogImage, ogType = "website", pubDate } = Astro.props;

const siteUrl = "https://brian-guerrero.github.io";
const pageUrl = canonical ?? `${siteUrl}${Astro.url.pathname}`;
const imageUrl = ogImage ?? `${siteUrl}${BASE_URL}/og-default.png`;
---

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={pageUrl} />
<meta name="generator" content="Astro" />

<link rel="icon" type="image/svg+xml" href={`${BASE_URL}/favicon.svg`} />

<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={pageUrl} />
<meta property="og:type" content={ogType} />
<meta property="og:image" content={imageUrl} />
<meta property="og:site_name" content="shortnr docs" />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl} />

{pubDate && <meta property="article:published_time" content={pubDate} />}

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
  href="https://fonts.googleapis.com/css2?family=Archivo+Black&family=Space+Grotesk:wght@400;500;700&family=IBM+Plex+Mono:wght@400;500&display=swap"
  rel="stylesheet"
/>
