---
import { getCollection, getEntry, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import DocsNav from "../../components/DocsNav.astro";

export const getStaticPaths = (async () => {
  const entries = await getCollection("docs");
  return entries.map((entry) => ({
    params: { slug: entry.id.replace(/\.md$/, "") },
    props: { entry },
  }));
}) satisfies import("astro").GetStaticPaths;

interface Props {
  entry: Awaited<ReturnType<typeof getEntry<"docs">>>;
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.description ?? `Documentation: ${entry.data.title}`}
>
  <div class="container docs-layout">
    <article class="docs-content">
      <Content />
    </article>
    <nav class="docs-sidebar" aria-label="Documentation navigation">
      <h3>Docs</h3>
      <DocsNav current={entry.id} />
    </nav>
  </div>
</BaseLayout>

<style>
  .docs-layout {
    display: grid;
    grid-template-columns: 1fr 220px;
    gap: var(--sn-space-8);
    padding-top: var(--sn-space-8);
    padding-bottom: var(--sn-space-8);
  }
  .docs-content {
    min-width: 0;
  }
  .docs-content h1:first-child {
    margin-top: 0;
  }
  .docs-sidebar {
    position: sticky;
    top: var(--sn-space-4);
    align-self: start;
  }
  .docs-sidebar h3 {
    font-family: var(--sn-font-body);
    font-size: var(--sn-text-small);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--sn-mid-gray);
    margin-top: 0;
    margin-bottom: var(--sn-space-3);
  }
  @media (max-width: 768px) {
    .docs-layout {
      grid-template-columns: 1fr;
    }
    .docs-sidebar {
      position: static;
      order: -1;
    }
  }
</style>
