{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Shortnr.Web (standalone)",
      "type": "dotnet",
      "request": "launch",
      "projectPath": "${workspaceFolder}/src/Shortnr.Web/Shortnr.Web.csproj",
      "launchSettingsProfile": "http",
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      }
    },
    {
      "name": "Shortnr.AppHost (Aspire)",
      "type": "dotnet",
      "request": "launch",
      "projectPath": "${workspaceFolder}/src/Shortnr.AppHost/Shortnr.AppHost.csproj",
      "launchSettingsProfile": "http",
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "DOTNET_ENVIRONMENT": "Development",
        "DOTNET_RESOURCE_SERVICE_ENDPOINT_URL": "http://localhost:22141",
        "DOTNET_DASHBOARD_OTLP_ENDPOINT_URL": "http://localhost:21050",
        "ASPIRE_ALLOW_UNSECURED_TRANSPORT": "true"
      }
    }
  ]
}
