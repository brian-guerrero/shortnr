@model DashboardDataViewModel
<div class="sn-grid-3">
    <article class="sn-stat-card">
        <header>Total Links</header>
        <h2>@Model.TotalLinks</h2>
    </article>
    <article class="sn-stat-card">
        <header>Total Clicks</header>
        <h2>@Model.TotalClicks</h2>
    </article>
    <article class="sn-stat-card">
        <header>Countries Reached</header>
        <h2>@Model.TotalCountries</h2>
    </article>
</div>

@if (Model.GeoBreakdown.Count == 0)
{
    <div class="sn-empty-state" role="status">No geographic data yet. Share a link to start collecting reach data.</div>
}
else
{
    <div class="sn-table-wrap">
    <table>
        <thead>
            <tr>
                <th>Country</th>
                <th>Clicks</th>
                <th>Top Cities</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.GeoBreakdown)
            {
                <tr>
                    <td>@item.CountryCode - @item.CountryName</td>
                    <td>@item.TotalClicks</td>
                    <td>
                        @if (item.CityCounts.Count == 0)
                        {
                            <span class="sn-muted">No city data</span>
                        }
                        else
                        {
                            @string.Join(", ", item.CityCounts.Select(c => $"{c.City} ({c.Count})"))
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
    </div>
}

<script id="chart-data" type="application/json">@Html.Raw(Model.ChartJson)</script>

<div id="recent-clicks" hx-swap-oob="true">
    <partial name="Shared/_RecentClicks" model="Model.RecentClicks" />
</div>
