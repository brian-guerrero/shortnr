@model Shortnr.Web.Pages.Bio.EditModel
@inject Shortnr.Web.Features.Theming.IThemeResolver ThemeResolver
@{
    // Combined preset + community theme list for both pickers below —
    // ThemeResolver aggregates every registered IThemeCatalog, so a new
    // community theme shows up here the moment it's in the manifest, with no
    // per-surface list to keep in sync.
    var themes = await ThemeResolver.GetAllThemesAsync();
}
<partial name="Shared/_StatusMessages" model="Model" />
@if (Model.BioPage is null)
{
    <p>Your bio page is one shareable URL that fans out to your links. It is powered by real short links, so every button gets click tracking and a QR code for free.</p>
    <form hx-post="/bio/edit?handler=Create" hx-target="#bio-editor" hx-swap="innerHTML">
        @Html.AntiForgeryToken()
        <label for="bio-slug">Bio page code</label>
        <input type="text" name="slug" id="bio-slug" placeholder="myhandle" required
               pattern="[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}" maxlength="64">
        <label for="bio-display-name">Display name</label>
        <input type="text" name="displayName" id="bio-display-name" placeholder="Casey's Corner" maxlength="256">
        <label for="bio-avatar">Avatar URL <small>(optional)</small></label>
        <input type="url" name="avatarUrl" id="bio-avatar" placeholder="https://example.com/avatar.png">
        <label for="bio-text">Bio text <small>(optional)</small></label>
        <textarea name="bioText" id="bio-text" rows="3" maxlength="2000"></textarea>
        <label for="bio-theme">Theme</label>
        <select name="theme" id="bio-theme">
            @foreach (var theme in themes)
            {
                <option value="@theme.Id">@theme.Label</option>
            }
        </select>
        <button type="submit">Create bio page</button>
    </form>
}
else
{
    <p>
        Your bio page is live at
        <a href="/bio/@Model.BioPage.Slug" target="_blank" rel="noopener">/bio/@Model.BioPage.Slug</a>.
    </p>
    <details>
        <summary role="button" class="secondary">Edit page settings</summary>
        <div>
            <form hx-post="/bio/edit?handler=Update" hx-target="#bio-editor" hx-swap="innerHTML">
                @Html.AntiForgeryToken()
                <label for="bio-display-name">Display name</label>
                <input type="text" name="displayName" id="bio-display-name" value="@Model.BioPage.DisplayName" maxlength="256">
                <label for="bio-avatar">Avatar URL <small>(optional)</small></label>
                <input type="url" name="avatarUrl" id="bio-avatar" value="@Model.BioPage.AvatarUrl" placeholder="https://example.com/avatar.png">
                <label for="bio-text">Bio text <small>(optional)</small></label>
                <textarea name="bioText" id="bio-text" rows="3" maxlength="2000">@Model.BioPage.BioText</textarea>
                <label for="bio-theme">Theme</label>
                <select name="theme" id="bio-theme">
                    @foreach (var theme in themes)
                    {
                        <option value="@theme.Id" selected="@(Model.BioPage.Theme == theme.Id)">@theme.Label</option>
                    }
                </select>
                <button type="submit">Save settings</button>
            </form>
        </div>
    </details>

    var addedLinkIds = Model.BioPage.Links.Select(l => l.ShortenedUrlId).ToHashSet();
    var availableLinks = Model.OwnerLinks.Where(l => !addedLinkIds.Contains(l.Id)).ToList();

    <details>
        <summary role="button" class="secondary">Add a link</summary>
        <div>
            <form hx-post="/bio/edit?handler=AddLink" hx-target="#bio-editor" hx-swap="innerHTML">
                @Html.AntiForgeryToken()
                <div class="grid">
                    <label for="bio-title">
                        Title <small>(optional)</small>
                        <input type="text" name="title" id="bio-title" placeholder="My latest remix" maxlength="256">
                    </label>
                    <label for="bio-link-pick">
                        Existing link
                        <select name="linkId" id="bio-link-pick">
                            <option value="">— choose an existing link —</option>
                            @foreach (var link in availableLinks)
                            {
                                <option value="@link.Id">
                                    @link.ShortCode — @(link.Domain?.Hostname ?? "default") — @link.LongUrl
                                </option>
                            }
                        </select>
                    </label>
                </div>
                <p><small>or create a new short link:</small></p>
                <div class="grid">
                    <input type="url" name="newUrl" placeholder="https://example.com/very/long/path">
                    <input type="text" name="newSlug" placeholder="Custom code (optional)" maxlength="64"
                           pattern="[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}">
                </div>
                <button type="submit">Add link</button>
            </form>
        </div>
    </details>

    @if (Model.BioPage.Links.Count == 0)
    {
        <partial name="Shared/_EmptyState" model="@(new EmptyStateViewModel { Message = "No links yet. Add your first one above." })" />
    }
    else
    {
        var bioLinks = Model.BioPage.Links.ToList();
        <div class="overflow-auto">
            <table class="stacked-table">
                <thead>
                    <tr>
                        <th>Title</th>
                        <th>Short URL</th>
                        <th>Clicks</th>
                        <th>Visible</th>
                        <th>Order</th>
                        <th>Remove</th>
                    </tr>
                </thead>
                <tbody>
                    @for (var i = 0; i < bioLinks.Count; i++)
                    {
                        var entry = bioLinks[i];
                        var link = entry.ShortenedUrl;
                        <tr>
                            <td data-label="Title">
                                @if (!entry.IsVisible)
                                {
                                    <partial name="Shared/_Badge" model="@(new BadgeViewModel { Kind = StatusKind.Plain, Text = "hidden" })" />
                                }
                                @if (link?.IsArchived == true)
                                {
                                    <partial name="Shared/_Badge" model="@(new BadgeViewModel { Kind = StatusKind.Error, Text = "archived — hidden from your live page" })" />
                                }
                                @* Keeps its own markup: carries an inline title input, not just a button. *@
                                <form hx-post="/bio/edit?handler=UpdateLinkTitle" hx-target="#bio-editor" hx-swap="innerHTML" class="title-edit-form">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@entry.Id">
                                    <input type="text" name="title" value="@entry.Title" maxlength="256" required>
                                    <button type="submit" class="secondary btn-sm">Save</button>
                                </form>
                            </td>
                            <td data-label="Short URL">
                                <a href="@Shortnr.Web.Features.ShortLinks.ShortUrlHelper.DisplayHref(Context.Request.Scheme, link?.Domain?.Hostname, link?.ShortCode ?? "")"
                                   target="_blank" rel="noopener">
                                    @Shortnr.Web.Features.ShortLinks.ShortUrlHelper.DisplayText(link?.Domain?.Hostname, link?.ShortCode ?? "")
                                </a>
                            </td>
                            <td data-label="Clicks">@(link?.ClickCount ?? 0)</td>
                            <td data-label="Visible">
                                <partial name="Shared/_ActionForm" model="@(new ActionFormViewModel
                                {
                                    PostUrl = "/bio/edit?handler=ToggleLink",
                                    Target = "#bio-editor",
                                    HiddenFields = { ["id"] = entry.Id.ToString() },
                                    ButtonLabel = entry.IsVisible ? "Hide" : "Show"
                                })" />
                            </td>
                            <td data-label="Order">
                                @if (i > 0)
                                {
                                    <partial name="Shared/_ActionForm" model="@(new ActionFormViewModel
                                    {
                                        PostUrl = "/bio/edit?handler=MoveLink",
                                        Target = "#bio-editor",
                                        HiddenFields = { ["id"] = entry.Id.ToString(), ["direction"] = "up" },
                                        ButtonLabel = "↑"
                                    })" />
                                }
                                @if (i < bioLinks.Count - 1)
                                {
                                    <partial name="Shared/_ActionForm" model="@(new ActionFormViewModel
                                    {
                                        PostUrl = "/bio/edit?handler=MoveLink",
                                        Target = "#bio-editor",
                                        HiddenFields = { ["id"] = entry.Id.ToString(), ["direction"] = "down" },
                                        ButtonLabel = "↓"
                                    })" />
                                }
                            </td>
                            <td data-label="Remove">
                                <partial name="Shared/_ActionForm" model="@(new ActionFormViewModel
                                {
                                    PostUrl = "/bio/edit?handler=RemoveLink",
                                    Target = "#bio-editor",
                                    HiddenFields = { ["id"] = entry.Id.ToString() },
                                    ButtonLabel = "Remove"
                                })" />
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
}
