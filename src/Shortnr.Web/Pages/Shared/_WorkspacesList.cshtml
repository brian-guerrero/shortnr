@model Shortnr.Web.Pages.Settings.WorkspacesModel
@{
    var expandedSlug = Model.ExpandedWorkspace;
}
@if (Model.StatusMessage is not null)
{
    <p class="sn-feedback sn-feedback-success" role="status">@Model.StatusMessage</p>
}
@if (Model.ErrorMessage is not null)
{
    <p class="sn-feedback sn-feedback-error" role="alert">@Model.ErrorMessage</p>
}
@if (Model.Workspaces.Count == 0)
{
    <div class="sn-empty-state" role="status">No workspaces yet. Create one above to get started.</div>
}
else
{
    <p><strong>@Model.Workspaces.Count workspace@(Model.Workspaces.Count == 1 ? "" : "s")</strong></p>
    @foreach (var ws in Model.Workspaces)
    {
        <article class="sn-card">
            <header>
                <hgroup>
                    <h3>@ws.Name</h3>
                    <p><code>@ws.Slug</code></p>
                </hgroup>
            </header>
            <div hx-get="/settings/workspaces?handler=Detail&id=@ws.Id" hx-trigger="revealed"
                 hx-swap="innerHTML">
                <div class="sn-loading-state" role="status" aria-live="polite">Loading members...</div>
            </div>
        </article>
    }
}
