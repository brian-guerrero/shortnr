@model Shortnr.Web.Pages.Settings.WorkspacesModel
@{
    var expandedSlug = Model.ExpandedWorkspace;
}
@if (Model.StatusMessage is not null)
{
    <p class="pico-background-green-100" style="padding: 0.5rem; border-radius: 0.25rem; margin-bottom: 1rem;">@Model.StatusMessage</p>
}
@if (Model.ErrorMessage is not null)
{
    <p class="pico-background-red-100" style="padding: 0.5rem; border-radius: 0.25rem; margin-bottom: 1rem;">@Model.ErrorMessage</p>
}
@if (Model.Workspaces.Count == 0)
{
    <p>No workspaces yet. Create one above to get started.</p>
}
else
{
    <p><strong>@Model.Workspaces.Count workspace@(Model.Workspaces.Count == 1 ? "" : "s")</strong></p>
    @foreach (var ws in Model.Workspaces)
    {
        <article style="margin-bottom: 1rem;">
            <header>
                <hgroup>
                    <h3>@ws.Name</h3>
                    <p><code>@ws.Slug</code></p>
                </hgroup>
            </header>
            <div hx-get="/settings/workspaces?handler=Detail&id=@ws.Id" hx-trigger="revealed"
                 hx-swap="innerHTML">
                <article aria-busy="true"><p>Loading members...</p></article>
            </div>
        </article>
    }
}
