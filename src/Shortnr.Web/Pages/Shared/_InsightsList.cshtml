@model Shortnr.Web.Pages.InsightsModel
<partial name="Shared/_StatusMessages" model="Model" />
@if (Model.Suggestions.Count == 0)
{
    <partial name="Shared/_EmptyState" model="@(new EmptyStateViewModel { Boxed = true, Message = $"No tag suggestions yet. Links with {Model.MinClicksForAnalysis}+ clicks are analyzed every {Model.AnalysisIntervalHours} hours; suggestions will appear here for you to accept or dismiss." })" />
}
else
{
    <div class="overflow-auto">
        <table class="stacked-table">
            <thead>
                <tr>
                    <th>Link</th>
                    <th>Suggested tag</th>
                    <th>Why</th>
                    <th>Clicks</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var s in Model.Suggestions)
                {
                    <tr>
                        <td data-label="Link"><code>@s.ShortCode</code></td>
                        <td data-label="Suggested tag">
                            <partial name="Shared/_Badge" model="@(new BadgeViewModel { Kind = StatusKind.Info, Text = s.SuggestedTag, PreserveCase = true })" />
                        </td>
                        <td data-label="Why">@s.SourceLabel</td>
                        <td data-label="Clicks">@s.ClickCount</td>
                        <td data-label="Actions">
                            <partial name="Shared/_ActionForm" model="@(new ActionFormViewModel
                            {
                                PostUrl = "/insights?handler=accept",
                                Target = "#insights-list",
                                HiddenFields = { ["id"] = s.Id.ToString() },
                                ButtonLabel = "Accept",
                                ButtonStyle = ActionButtonStyle.Primary
                            })" />
                            <partial name="Shared/_ActionForm" model="@(new ActionFormViewModel
                            {
                                PostUrl = "/insights?handler=dismiss",
                                Target = "#insights-list",
                                HiddenFields = { ["id"] = s.Id.ToString() },
                                ButtonLabel = "Dismiss"
                            })" />
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
