@model List<ClickEvent>
@{
    var clickSort = Context.Request.Query["clickSort"].FirstOrDefault() ?? "";
    var clickDir = Context.Request.Query["clickDir"].FirstOrDefault() ?? "";
    var pollUrl = clickSort != "" ? "/dashboard?clickSort=" + clickSort + "&clickDir=" + clickDir : "/dashboard";

    var scUrl = "/dashboard?clickSort=shortCode&clickDir=" + (clickSort == "shortCode" && clickDir == "asc" ? "desc" :
"asc");
    var scInd = clickSort == "shortCode" ? clickDir == "asc" ? " ▲" : " ▼" : "";
    var ipUrl = "/dashboard?clickSort=ipAddress&clickDir=" + (clickSort == "ipAddress" && clickDir == "asc" ? "desc" :
"asc");
    var ipInd = clickSort == "ipAddress" ? clickDir == "asc" ? " ▲" : " ▼" : "";
    var rfUrl = "/dashboard?clickSort=referer&clickDir=" + (clickSort == "referer" && clickDir == "asc" ? "desc" : "asc");
    var rfInd = clickSort == "referer" ? clickDir == "asc" ? " ▲" : " ▼" : "";
    var uaUrl = "/dashboard?clickSort=userAgent&clickDir=" + (clickSort == "userAgent" && clickDir == "asc" ? "desc" :
"asc");
    var uaInd = clickSort == "userAgent" ? clickDir == "asc" ? " ▲" : " ▼" : "";
    var ctUrl = "/dashboard?clickSort=clickedAtUtc&clickDir=" + (clickSort == "clickedAtUtc" && clickDir == "asc" ? "desc" :
"asc");
    var ctInd = clickSort == "clickedAtUtc" ? clickDir == "asc" ? " ▲" : " ▼" : "";
}
@if (Model.Count == 0)
{
    <p style="text-align: center;">No clicks yet</p>
}
else
{
    <table class="sortable" hx-get="@pollUrl" hx-trigger="every 5s" hx-target="#recent-clicks" hx-swap="innerHTML">
        <thead>
            <tr>
                <th hx-get="@scUrl" hx-target="#recent-clicks" hx-swap="innerHTML">Short URL @scInd</th>
                <th hx-get="@ipUrl" hx-target="#recent-clicks" hx-swap="innerHTML">IP @ipInd</th>
                <th hx-get="@rfUrl" hx-target="#recent-clicks" hx-swap="innerHTML">Referer @rfInd</th>
                <th hx-get="@uaUrl" hx-target="#recent-clicks" hx-swap="innerHTML">User Agent @uaInd</th>
                <th hx-get="@ctUrl" hx-target="#recent-clicks" hx-swap="innerHTML">Time @ctInd</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var click in Model)
            {
                <tr>
                    <td><a href="/@click.ShortenedUrl.ShortCode" target="_blank">/@click.ShortenedUrl.ShortCode</a></td>
                    <td>@click.IpAddress</td>
                    <td style="max-width: 250px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;"
                        title="@click.Referer">@click.Referer</td>
                    <td style="max-width: 200px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;"
                        title="@click.UserAgent">@click.UserAgent</td>
                    <td>@click.ClickedAtUtc.ToLocalTime().ToString("g")</td>
                </tr>
            }
        </tbody>
    </table>
}
