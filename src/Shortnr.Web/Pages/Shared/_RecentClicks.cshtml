@model List<ClickEventRow>
@{
    var clickSort = Context.Request.Query["clickSort"].FirstOrDefault() ?? "";
    var clickDir = Context.Request.Query["clickDir"].FirstOrDefault() ?? "";
    var clickLimit = Context.Request.Query["clickLimit"].FirstOrDefault() ?? "5";

    var sortUrl = (string col, string dir) => "/dashboard?clickSort=" + col + "&clickDir=" + dir + "&clickLimit=" + clickLimit;
    var sortInd = (string col, string asc, string desc) =>
        clickSort == col ? (clickDir == "asc" ? asc : desc) : "";
}
@if (Model.Count == 0)
{
    <div class="sn-empty-state" role="status">No clicks yet. Share a link to start collecting activity.</div>
}
else
{
    <div class="sn-table-wrap">
    <table class="sortable sn-responsive-table">
        <thead>
            <tr>
                <th role="button" tabindex="0" aria-label="Sort by short URL" hx-get="@sortUrl("shortCode", clickSort == "shortCode" && clickDir == "asc" ? "desc" : "asc")" hx-target="#recent-clicks" hx-swap="innerHTML">Short URL @sortInd("shortCode", " ▲", " ▼")</th>
                <th role="button" tabindex="0" aria-label="Sort by country" hx-get="@sortUrl("countryCode", clickSort == "countryCode" && clickDir == "asc" ? "desc" : "asc")" hx-target="#recent-clicks" hx-swap="innerHTML">Country @sortInd("countryCode", " ▲", " ▼")</th>
                <th role="button" tabindex="0" aria-label="Sort by browser" hx-get="@sortUrl("browser", clickSort == "browser" && clickDir == "asc" ? "desc" : "asc")" hx-target="#recent-clicks" hx-swap="innerHTML">Browser @sortInd("browser", " ▲", " ▼")</th>
                <th role="button" tabindex="0" aria-label="Sort by operating system" hx-get="@sortUrl("operatingSystem", clickSort == "operatingSystem" && clickDir == "asc" ? "desc" : "asc")" hx-target="#recent-clicks" hx-swap="innerHTML">OS @sortInd("operatingSystem", " ▲", " ▼")</th>
                <th role="button" tabindex="0" aria-label="Sort by referrer" hx-get="@sortUrl("referer", clickSort == "referer" && clickDir == "asc" ? "desc" : "asc")" hx-target="#recent-clicks" hx-swap="innerHTML">Referer @sortInd("referer", " ▲", " ▼")</th>
                <th role="button" tabindex="0" aria-label="Sort by time" hx-get="@sortUrl("clickedAtUtc", clickSort == "clickedAtUtc" && clickDir == "asc" ? "desc" : "asc")" hx-target="#recent-clicks" hx-swap="innerHTML">Time @sortInd("clickedAtUtc", " ▲", " ▼")</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var click in Model)
            {
                <tr>
                    <td data-label="Short URL"><a href="@ShortUrlHelper.DisplayHref(Context.Request.Scheme, click.Hostname, click.ShortCode)" target="_blank">@ShortUrlHelper.DisplayText(click.Hostname, click.ShortCode)</a></td>
                    <td data-label="Country">@click.CountryCode</td>
                    <td data-label="Browser">@click.Browser @click.BrowserVersion</td>
                    <td data-label="OS">@click.OperatingSystem @click.OSVersion</td>
                    <td data-label="Referer" class="sn-break" title="@click.Referer">@click.Referer</td>
                    <td data-label="Time">@click.ClickedAtUtc.ToLocalTime().ToString("g")</td>
                </tr>
                <tr class="detail-row" data-click-id="@click.Id">
                    <td colspan="6" class="sn-click-detail">
                        <strong>IP:</strong> @click.IpAddress |
                        <strong>UA:</strong> @click.UserAgent |
                        <strong>Device:</strong> @click.DeviceFamily |
                        <strong>City:</strong> @click.CityName
                    </td>
                </tr>
            }
        </tbody>
    </table>
    </div>
    <div class="sn-pagination-control">
        <label for="per-page">Rows per page:</label>
        <select id="per-page"
                hx-get="/dashboard?clickSort=@clickSort&clickDir=@clickDir"
                hx-target="#recent-clicks"
                hx-swap="innerHTML"
                hx-trigger="change"
                name="clickLimit">
            <option value="5" selected="@(clickLimit == "5")">5</option>
            <option value="10" selected="@(clickLimit == "10")">10</option>
            <option value="15" selected="@(clickLimit == "15")">15</option>
            <option value="20" selected="@(clickLimit == "20")">20</option>
        </select>
    </div>
}
