@model List<ClickEventRow>
@{
    var clickSort = Context.Request.Query["clickSort"].FirstOrDefault() ?? "";
    var clickDir = Context.Request.Query["clickDir"].FirstOrDefault() ?? "";
    var clickLimit = Context.Request.Query["clickLimit"].FirstOrDefault() ?? "5";
    var sort = TableSortState.FromQuery(
        Context.Request, "clickSort", "clickDir", "/dashboard", "#recent-clicks",
        extraQuery: new Dictionary<string, string?> { ["clickLimit"] = clickLimit });
}
@if (Model.Count == 0)
{
    <partial name="Shared/_EmptyState" model="@(new EmptyStateViewModel { Message = "No clicks yet", CssClass = "empty-state-centered" })" />
}
else
{
    <div class="overflow-auto">
        <table class="sortable">
            <thead>
                <tr>
                    <partial name="Shared/_SortableHeader" model="@sort.Header("shortCode", "Short URL")" />
                    <partial name="Shared/_SortableHeader" model="@sort.Header("countryCode", "Country")" />
                    <partial name="Shared/_SortableHeader" model="@sort.Header("browser", "Browser")" />
                    <partial name="Shared/_SortableHeader" model="@sort.Header("operatingSystem", "OS")" />
                    <partial name="Shared/_SortableHeader" model="@sort.Header("referer", "Referer")" />
                    <partial name="Shared/_SortableHeader" model="@sort.Header("clickedAtUtc", "Time")" />
                </tr>
            </thead>
            <tbody>
                @foreach (var click in Model)
                {
                    <tr>
                        <td><a href="@ShortUrlHelper.DisplayHref(Context.Request.Scheme, click.Hostname, click.ShortCode)" target="_blank">@ShortUrlHelper.DisplayText(click.Hostname, click.ShortCode)</a></td>
                        <td>@click.CountryCode</td>
                        <td>@click.Browser @click.BrowserVersion</td>
                        <td>@click.OperatingSystem @click.OSVersion</td>
                        <td title="@click.Referer">@click.Referer</td>
                        <td>@click.ClickedAtUtc.ToLocalTime().ToString("g")</td>
                    </tr>
                    @* Inline display is load-bearing: Dashboard.cshtml's toggle script selects on [style*="table-row"]. *@
                    <tr style="display: none;" class="detail-row" data-click-id="@click.Id">
                        <td colspan="6">
                            <strong>IP:</strong> @click.IpAddress |
                            <strong>UA:</strong> @click.UserAgent |
                            <strong>Device:</strong> @click.DeviceFamily |
                            <strong>City:</strong> @click.CityName
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <div class="table-controls">
        <label for="per-page">Per page:</label>
        <select id="per-page" class="input-inline"
                hx-get="/dashboard?clickSort=@clickSort&clickDir=@clickDir"
                hx-target="#recent-clicks"
                hx-swap="innerHTML"
                hx-trigger="change"
                name="clickLimit">
            <option value="5" selected="@(clickLimit == "5")">5</option>
            <option value="10" selected="@(clickLimit == "10")">10</option>
            <option value="15" selected="@(clickLimit == "15")">15</option>
            <option value="20" selected="@(clickLimit == "20")">20</option>
        </select>
    </div>
}
