@inject Microsoft.Extensions.Configuration.IConfiguration _config
@{
    var authEnabled = _config.GetValue<bool>("Authentication:Enabled", defaultValue: true);
}
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>shortnr</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="/css/site.css">
    <script src="/lib/htmx/dist/htmx.min.js"></script>
    <script src="/lib/htmx-ext-sse/dist/sse.min.js"></script>
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
    <link rel="manifest" href="/site.webmanifest">
</head>

<body hx-ext="sse">
    <header class="site-nav">
        <div class="nav-inner">
            <a href="/" class="nav-brand">
                <span>shortnr</span>
                <span class="nav-badge">app</span>
            </a>
            <nav aria-label="Main navigation">
                <ul class="nav-links">
                    @if (!authEnabled || User.Identity?.IsAuthenticated == true)
                    {
                        <li>
                            <details class="dropdown nav-dropdown">
                                <summary>Dashboard</summary>
                                <ul>
                                    <li><a href="/dashboard">Overview</a></li>
                                    <li><a href="/dashboard/activity">AI activity</a></li>
                                </ul>
                            </details>
                        </li>
                        <li><a href="/bio/edit">Bio page</a></li>
                        <li>
                            <details class="dropdown nav-dropdown">
                                <summary>Settings</summary>
                                <ul>
                                    <li><a href="/settings/domains">Domains</a></li>
                                    <li><a href="/settings/workspaces">Workspaces</a></li>
                                    <li><a href="/settings/api-keys">API keys</a></li>
                                    <li><a href="/settings/webhooks">Webhooks</a></li>
                                </ul>
                            </details>
                        </li>
                    }
                    @if (authEnabled)
                    {
                        if (User.Identity?.IsAuthenticated == true)
                        {
                            <li>@await Html.PartialAsync("Shared/_UserMenu")</li>
                        }
                        else
                        {
                            <li><a href="/account/login">Log in</a></li>
                        }
                    }
                </ul>
            </nav>
        </div>
    </header>
    <main class="container" style="padding-top: var(--sn-space-6);">
        @RenderBody()
    </main>

    @await RenderSectionAsync("Scripts", required: false)

    <footer class="site-footer">
        <p>This product includes GeoLite2 data created by MaxMind, available from <a href="https://www.maxmind.com" target="_blank" rel="noopener">https://www.maxmind.com</a>.</p>
    </footer>
</body>

</html>
