@inject Microsoft.Extensions.Configuration.IConfiguration _config
@{
    var authEnabled = _config.GetValue<bool>("Authentication:Enabled", defaultValue: true);
}
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>shortnr</title>
    <meta name="theme-color" content="#111111" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="/css/site.css">
    @* Inline and before the body on purpose: resolving the scheme after first
       paint is what causes a flash of the wrong theme. *@
    <script>
        (function () {
            var scheme;
            try { scheme = localStorage.getItem('sn-color-scheme'); } catch (e) { scheme = null; }
            if (scheme !== 'light' && scheme !== 'dark') {
                scheme = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
            }
            var root = document.documentElement;
            root.setAttribute('data-color-scheme', scheme);
            // The mobile nav only collapses behind the hamburger once this
            // class lands, so a phone with JavaScript disabled still gets
            // the full, wrapped link list instead of an unreachable menu.
            root.classList.add('js');
        })();
    </script>
    <script src="/js/color-scheme.js" defer></script>
    <script src="/js/nav-toggle.js" defer></script>
    <script src="/lib/htmx/dist/htmx.min.js"></script>
    <script src="/lib/htmx-ext-sse/dist/sse.min.js"></script>
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
    <link rel="manifest" href="/site.webmanifest">
</head>

<body hx-ext="sse">
    <header class="site-nav">
        <div class="nav-inner">
            <a href="/" class="nav-brand">
                <span>shortnr</span>
                <span class="nav-badge">app</span>
            </a>
            @* Hidden until the script reveals it, so it is not a dead
               control when JavaScript is unavailable — the full link list
               below is still reachable (just wrapped) without JS. *@
            <button type="button" class="nav-toggle" data-nav-toggle
                    aria-expanded="false" aria-controls="primary-nav"
                    aria-label="Toggle navigation menu" hidden>☰</button>
            <nav aria-label="Main navigation" id="primary-nav">
                <ul class="nav-links">
                    @if (!authEnabled || User.Identity?.IsAuthenticated == true)
                    {
                        <li>
                            <details class="dropdown nav-dropdown">
                                <summary>Dashboard</summary>
                                <ul>
                                    <li><a href="/dashboard">Overview</a></li>
                                    <li><a href="/dashboard/activity">AI activity</a></li>
                                    @if (_config.GetValue<bool>("AiInsights:Enabled", defaultValue: false))
                                    {
                                        <li><a href="/insights">AI insights</a></li>
                                    }
                                </ul>
                            </details>
                        </li>
                        <li><a href="/bio/edit">Bio page</a></li>
                        <li>
                            <details class="dropdown nav-dropdown">
                                <summary>Settings</summary>
                                <ul>
                                    <li><a href="/settings/domains">Domains</a></li>
                                    <li><a href="/settings/workspaces">Workspaces</a></li>
                                    <li><a href="/settings/api-keys">API keys</a></li>
                                    <li><a href="/settings/webhooks">Webhooks</a></li>
                                </ul>
                            </details>
                        </li>
                    }
                    @if (authEnabled)
                    {
                        if (User.Identity?.IsAuthenticated == true)
                        {
                            <li>@await Html.PartialAsync("Shared/_UserMenu")</li>
                        }
                        else
                        {
                            <li><a href="/account/login">Log in</a></li>
                        }
                    }
                    @* Hidden until the script reveals it, so it is not a dead
                       control when JavaScript is unavailable. *@
                    <li>
                        <button type="button" class="scheme-toggle" data-scheme-toggle
                                aria-pressed="false" aria-label="Switch to dark theme" hidden>☾</button>
                    </li>
                </ul>
            </nav>
        </div>
    </header>
    <main class="container" style="padding-top: var(--sn-space-6);">
        @RenderBody()
    </main>

    @await RenderSectionAsync("Scripts", required: false)

    <footer class="site-footer">
        <p>This product includes GeoLite2 data created by MaxMind, available from <a href="https://www.maxmind.com" target="_blank" rel="noopener">https://www.maxmind.com</a>.</p>
    </footer>
</body>

</html>
