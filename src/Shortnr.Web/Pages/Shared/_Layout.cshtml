<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>shortnr</title>
    <link rel="stylesheet" href="/lib/pico/css/pico.min.css">
    <script src="/lib/htmx/dist/htmx.min.js"></script>
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
    <link rel="manifest" href="/site.webmanifest">
    <style>
        /* User menu dropdown */
        .user-menu {
            position: relative;
            display: inline-flex;
            align-items: center;
        }

        .user-menu__trigger {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            background: none;
            border: none;
            padding: 0.25rem 0.5rem;
            margin: 0;
            cursor: pointer;
            color: inherit;
            font: inherit;
            border-radius: var(--pico-border-radius, 4px);
            /* suppress any Pico button box-shadow / outline defaults */
            box-shadow: none;
        }

        .user-menu__trigger:hover {
            background: var(--pico-nav-link-hover-background, rgba(128,128,128,.12));
            box-shadow: none;
        }

        .user-menu__trigger:focus-visible {
            outline: 2px solid var(--pico-primary, #1095c1);
            outline-offset: 2px;
            box-shadow: none;
        }

        .user-menu__avatar {
            border-radius: 50%;
            display: block;
            flex-shrink: 0;
        }

        .user-menu__name {
            max-width: 14ch;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
            font-size: 0.9rem;
        }

        .user-menu__caret {
            font-size: .55em;
            opacity: .5;
        }

        .user-menu__dropdown {
            display: none;
            position: absolute;
            top: calc(100% + 6px);
            right: 0;
            min-width: 9rem;
            background: var(--pico-card-background-color, #fff);
            border: 1px solid var(--pico-muted-border-color, rgba(128,128,128,.25));
            border-radius: var(--pico-border-radius, 4px);
            box-shadow: 0 6px 16px rgba(0,0,0,.15);
            list-style: none;
            padding: 0.3rem 0;
            margin: 0;
            z-index: 200;
        }

        /* Reset any Pico nav li/a styles inside the dropdown */
        .user-menu__dropdown li {
            padding: 0;
            margin: 0;
        }

        .user-menu__dropdown li a {
            display: block;
            padding: 0.45rem 1rem;
            white-space: nowrap;
            text-decoration: none !important;
            color: inherit !important;
            background: none;
            border: none;
            font-size: 0.9rem;
        }

        .user-menu__dropdown li a:hover {
            background: var(--pico-nav-link-hover-background, rgba(128,128,128,.12));
        }

        /* Show on hover or when trigger is focused (keyboard-accessible) */
        .user-menu:hover .user-menu__dropdown,
        .user-menu:focus-within .user-menu__dropdown {
            display: block;
        }
    </style>
</head>

<body>
    <nav class="container" style="max-width: 960px; padding-top: 1rem;">
        <ul>
            <li><strong><a href="/" style="--pico-text-decoration: none;">shortnr</a></strong></li>
        </ul>
        <ul>
            <li><a href="/dashboard">Dashboard</a></li>
        </ul>
        <ul>
            @if (User.Identity?.IsAuthenticated == true)
            {
                <li>@await Html.PartialAsync("Shared/_UserMenu")</li>
            }
            else
            {
                <li><a href="/account/login">Log in</a></li>
            }
        </ul>
    </nav>
    <main class="container" style="max-width: 960px; padding-top: 1rem;">
        @RenderBody()
    </main>

    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>
