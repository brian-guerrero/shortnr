@inject Microsoft.Extensions.Configuration.IConfiguration _config
@{
    var authEnabled = _config.GetValue<bool>("Authentication:Enabled", defaultValue: true);
    var seo = _config.GetSection("Seo");
    var seoDescription = seo["Description"] ?? "shortnr — a self-hosted URL shortener with a dashboard, link-in-bio pages, branded domains, and a REST API.";
    var seoAuthor = seo["Author"] ?? "shortnr";
    var seoSiteName = seo["SiteName"] ?? "shortnr";
    var seoLocale = seo["Locale"] ?? "en_US";
    var canonicalUrl = $"{Context.Request.Scheme}://{Context.Request.Host}{Context.Request.PathBase}{Context.Request.Path}";
    var currentPath = Context.Request.Path.Value ?? string.Empty;
}
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="@seoDescription" />
    <meta name="author" content="@seoAuthor" />
    <link rel="canonical" href="@canonicalUrl" />
    <meta property="og:site_name" content="@seoSiteName" />
    <meta property="og:locale" content="@seoLocale" />
    <meta property="og:title" content="@seoSiteName" />
    <meta property="og:description" content="@seoDescription" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="@canonicalUrl" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content="@seoSiteName" />
    <meta name="twitter:description" content="@seoDescription" />
    <title>shortnr</title>
    <link rel="stylesheet" href="/lib/pico/css/pico.min.css">
    <link rel="stylesheet" href="/lib/pico/css/pico.colors.min.css">
    <link rel="stylesheet" href="/css/site.css">
    <script src="/lib/htmx/dist/htmx.min.js"></script>
    <script src="/lib/htmx-ext-sse/dist/sse.min.js"></script>
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
    <link rel="manifest" href="/site.webmanifest">
</head>

<body class="sn-app" hx-ext="sse">
    <nav class="container sn-container sn-nav">
        <ul>
            <li><a class="sn-brand" href="/">shortnr</a></li>
        </ul>
        <ul class="sn-desktop-nav">
            @if (!authEnabled || User.Identity?.IsAuthenticated == true)
            {
                <li><a class="@(currentPath == "/dashboard" ? "sn-nav-active" : "")" href="/dashboard" aria-current="@(currentPath == "/dashboard" ? "page" : null)">Dashboard</a></li>
                <li><a class="@(currentPath.StartsWith("/dashboard/activity") ? "sn-nav-active" : "")" href="/dashboard/activity" aria-current="@(currentPath.StartsWith("/dashboard/activity") ? "page" : null)">AI activity</a></li>
                <li><a class="@(currentPath.StartsWith("/bio/edit") ? "sn-nav-active" : "")" href="/bio/edit" aria-current="@(currentPath.StartsWith("/bio/edit") ? "page" : null)">Bio page</a></li>
                <li>
                    <details class="sn-nav-menu">
                        <summary class="@(currentPath.StartsWith("/settings/") ? "sn-nav-active" : "")">Settings</summary>
                        <ul>
                            <li><a href="/settings/domains">Domains</a></li>
                            <li><a href="/settings/workspaces">Workspaces</a></li>
                            <li><a href="/settings/api-keys">API keys</a></li>
                            <li><a href="/settings/webhooks">Webhooks</a></li>
                        </ul>
                    </details>
                </li>
            }
            @if (authEnabled)
            {
                if (User.Identity?.IsAuthenticated == true)
                {
                    <li>@await Html.PartialAsync("Shared/_UserMenu")</li>
                }
                else
                {
                    <li><a href="/account/login">Log in</a></li>
                }
            }
        </ul>
        <details class="sn-mobile-menu">
            <summary aria-label="Open navigation"><span aria-hidden="true"></span><span aria-hidden="true"></span><span aria-hidden="true"></span></summary>
            <div class="sn-mobile-menu-panel">
                @if (!authEnabled || User.Identity?.IsAuthenticated == true)
                {
                    <a href="/dashboard">Dashboard</a>
                    <a href="/dashboard/activity">AI activity</a>
                    <a href="/bio/edit">Bio page</a>
                    <p class="sn-mobile-menu-label">Settings</p>
                    <a href="/settings/domains">Domains</a>
                    <a href="/settings/workspaces">Workspaces</a>
                    <a href="/settings/api-keys">API keys</a>
                    <a href="/settings/webhooks">Webhooks</a>
                }
                @if (authEnabled)
                {
                    if (User.Identity?.IsAuthenticated == true)
                    {
                        @await Html.PartialAsync("Shared/_UserMenu")
                    }
                    else
                    {
                        <a href="/account/login">Log in</a>
                    }
                }
            </div>
        </details>
    </nav>
    <main class="container sn-container sn-main">
        @RenderBody()
    </main>

    @await RenderSectionAsync("Scripts", required: false)

    <footer class="container sn-container sn-footer">
        <p>This product includes GeoLite2 data created by MaxMind, available from <a href="https://www.maxmind.com" target="_blank" rel="noopener">https://www.maxmind.com</a>.</p>
    </footer>
</body>

</html>
