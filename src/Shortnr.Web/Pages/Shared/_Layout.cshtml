@inject Microsoft.Extensions.Configuration.IConfiguration _config
@inject Shortnr.Web.Features.Authentication.IUserIdentityService _identity
@using Shortnr.Web.Features.Theming
@{
    var authEnabled = _config.GetValue<bool>("Authentication:Enabled", defaultValue: true);
    // Default (no explicit preference) leaves data-color-scheme unset here so
    // the client-side toggle/OS-preference logic below still owns it, same as
    // before this feature existed. Any other theme pins the scheme from
    // Theme.IsDark, the same contract _BioLayout/_PreviewLayout use for their
    // content — see app-theme-bridge.css for what the theme's stylesheet
    // actually reskins.
    var theme = await _identity.ResolveThemePreferenceAsync(User);
    var themePinned = theme.Id != ThemeCatalog.DefaultId;
}
<!DOCTYPE html>
<html lang="en" data-theme="@theme.Id"
      data-color-scheme="@(themePinned ? (theme.IsDark ? "dark" : "light") : null)"
      data-theme-pinned="@(themePinned ? "true" : null)">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>shortnr</title>
    <meta name="theme-color" content="#111111" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="/css/site.css">
    @* One shared palette per theme, same file _BioLayout/_PreviewLayout link
       (see Theme.PreviewStylesheetPath) — not a third per-surface palette.
       app-theme-bridge.css (linked right after) maps the --pv-* tokens this
       exposes onto the --sn-* tokens the app chrome actually reads. *@
    <link rel="stylesheet" href="/@theme.PreviewStylesheetPath">
    <link rel="stylesheet" href="/css/app-theme-bridge.css">
    @* Inline and before the body on purpose: resolving the scheme after first
       paint is what causes a flash of the wrong theme. Skipped when the
       server already pinned data-color-scheme above (a non-default theme is
       active) so a pinned scheme isn't clobbered by localStorage/OS. *@
    <script>
        (function () {
            var root = document.documentElement;
            if (!root.hasAttribute('data-color-scheme')) {
                var scheme;
                try { scheme = localStorage.getItem('sn-color-scheme'); } catch (e) { scheme = null; }
                if (scheme !== 'light' && scheme !== 'dark') {
                    scheme = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
                }
                root.setAttribute('data-color-scheme', scheme);
            }
            // The mobile nav only collapses behind the hamburger once this
            // class lands, so a phone with JavaScript disabled still gets
            // the full, wrapped link list instead of an unreachable menu.
            root.classList.add('js');
        })();
    </script>
    <script src="/js/color-scheme.js" defer></script>
    <script src="/js/nav-toggle.js" defer></script>
    <script src="/lib/htmx/dist/htmx.min.js"></script>
    <script src="/lib/htmx-ext-sse/dist/sse.min.js"></script>
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
    <link rel="manifest" href="/site.webmanifest">
</head>

<body hx-ext="sse">
    <header class="site-nav">
        <div class="nav-inner">
            <a href="/" class="nav-brand">
                <span>shortnr</span>
                <span class="nav-badge">app</span>
            </a>
            @* Hidden until the script reveals it, so it is not a dead
               control when JavaScript is unavailable — the full link list
               below is still reachable (just wrapped) without JS. *@
            <button type="button" class="nav-toggle" data-nav-toggle
                    aria-expanded="false" aria-controls="primary-nav"
                    aria-label="Toggle navigation menu" hidden>☰</button>
            <nav aria-label="Main navigation" id="primary-nav">
                <ul class="nav-links">
                    @if (!authEnabled || User.Identity?.IsAuthenticated == true)
                    {
                        <li>
                            <details class="dropdown nav-dropdown">
                                <summary>Dashboard</summary>
                                <ul>
                                    <li><a href="/dashboard">Overview</a></li>
                                    <li><a href="/dashboard/activity">AI activity</a></li>
                                    @if (_config.GetValue<bool>("AiInsights:Enabled", defaultValue: false))
                                    {
                                        <li><a href="/insights">AI insights</a></li>
                                    }
                                </ul>
                            </details>
                        </li>
                        <li><a href="/bio/edit">Bio page</a></li>
                        <li>
                            <details class="dropdown nav-dropdown">
                                <summary>Settings</summary>
                                <ul>
                                    <li><a href="/settings/domains">Domains</a></li>
                                    <li><a href="/settings/workspaces">Workspaces</a></li>
                                    <li><a href="/settings/api-keys">API keys</a></li>
                                    <li><a href="/settings/webhooks">Webhooks</a></li>
                                </ul>
                            </details>
                        </li>
                    }
                    @if (authEnabled)
                    {
                        if (User.Identity?.IsAuthenticated == true)
                        {
                            <li>@await Html.PartialAsync("Shared/_UserMenu")</li>
                        }
                        else
                        {
                            <li><a href="/account/login">Log in</a></li>
                        }
                    }
                    @* Hidden until the script reveals it, so it is not a dead
                       control when JavaScript is unavailable. *@
                    <li>
                        <button type="button" class="scheme-toggle" data-scheme-toggle
                                aria-pressed="false" aria-label="Switch to dark theme" hidden>☾</button>
                    </li>
                </ul>
            </nav>
        </div>
    </header>
    <main class="container" style="padding-top: var(--sn-space-6);">
        @RenderBody()
    </main>

    @* Out-of-band swap target for bulk-action toast confirmations (PRD-019):
       the toast travels here so it is never nested inside the swapped table. *@
    <div id="bulk-toast-wrap" aria-live="polite"></div>

    @await RenderSectionAsync("Scripts", required: false)

    @if (!authEnabled || User.Identity?.IsAuthenticated == true)
    {
        @await Html.PartialAsync("Shared/_CommandPalette")
    }
    <script src="/js/bulk-actions.js" defer></script>
    <script src="/js/command-palette.js" defer></script>
    <script src="/js/link-detail.js" defer></script>

    <footer class="site-footer">
        <p>This product includes GeoLite2 data created by MaxMind, available from <a href="https://www.maxmind.com" target="_blank" rel="noopener">https://www.maxmind.com</a>.</p>
    </footer>
</body>

</html>
