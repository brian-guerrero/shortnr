@inject Microsoft.Extensions.Configuration.IConfiguration _config
@{
    var authEnabled = _config.GetValue<bool>("Authentication:Enabled", defaultValue: true);
}
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>shortnr</title>
    <link rel="stylesheet" href="/lib/pico/css/pico.min.css">
    <script src="/lib/htmx/dist/htmx.min.js"></script>
    <script src="/lib/htmx-ext-sse/dist/sse.min.js"></script>
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
    <link rel="manifest" href="/site.webmanifest">
    <style>
        .nav-avatar { border-radius: 50%; vertical-align: middle; }
    </style>
</head>

<body hx-ext="sse">
    <nav class="container" style="max-width: 960px; padding-top: 1rem;">
        <ul>
            <li><strong><a href="/" style="--pico-text-decoration: none;">shortnr</a></strong></li>
        </ul>
        <ul>
            @if (!authEnabled || User.Identity?.IsAuthenticated == true)
            {
                <li><a href="/dashboard">Dashboard</a></li>
                <li><a href="/settings/domains">Settings</a></li>
            }
            @if (authEnabled)
            {
                if (User.Identity?.IsAuthenticated == true)
                {
                    <li>@await Html.PartialAsync("Shared/_UserMenu")</li>
                }
                else
                {
                    <li><a href="/account/login">Log in</a></li>
                }
            }
        </ul>
    </nav>
    <main class="container" style="max-width: 960px; padding-top: 1rem;">
        @RenderBody()
    </main>

    @await RenderSectionAsync("Scripts", required: false)

    <footer class="container" style="max-width: 960px; padding: 2rem 0 1rem; text-align: center; color: var(--pico-muted-color); font-size: 0.8rem;">
        <p>This product includes GeoLite2 data created by MaxMind, available from <a href="https://www.maxmind.com" target="_blank" rel="noopener">https://www.maxmind.com</a>.</p>
    </footer>
</body>

</html>
