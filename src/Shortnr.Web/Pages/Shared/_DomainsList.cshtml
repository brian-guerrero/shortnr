@model Shortnr.Web.Pages.Settings.DomainsModel
@if (Model.ErrorMessage is not null)
{
    <mark class="pico-background-red-100" style="display:block; margin-bottom: 1rem;">
        <strong>@Model.ErrorMessage</strong>
    </mark>
}
@if (Model.StatusMessage is not null)
{
    <mark class="pico-background-green-100" style="display:block; margin-bottom: 1rem;">
        <strong>@Model.StatusMessage</strong>
    </mark>
}
@if (Model.Domains.Count == 0)
{
    <p>No custom domains yet. Add one above to start using branded short links.</p>
}
else
{
    <table>
        <thead>
            <tr><th>Domain</th><th>Status</th><th>Verification token</th><th>Actions</th></tr>
        </thead>
        <tbody>
            @foreach (var domain in Model.Domains)
            {
                <tr>
                    <td>
                        <code>@domain.Hostname</code>
                        @if (domain.IsDefault)
                        {
                            <mark class="pico-background-blue-100" style="margin-left: 0.5rem;">default</mark>
                        }
                    </td>
                    <td>
                        @if (domain.IsVerified)
                        {
                            <mark class="pico-background-green-100">verified</mark>
                        }
                        else
                        {
                            <mark>unverified</mark>
                        }
                    </td>
                    <td>
                        @if (domain.IsVerified)
                        {
                            <small>—</small>
                        }
                        else
                        {
                            <code style="font-size: 0.75rem;">@domain.VerificationToken</code>
                            <div style="font-size: 0.75rem; margin-top: 0.25rem;">
                                <strong>File:</strong> /.well-known/shortnr-verify.txt
                                <br>
                                <strong>DNS TXT:</strong> _shortnr-verify.@(domain.Hostname)
                            </div>
                        }
                    </td>
                    <td>
                        @if (!domain.IsVerified)
                        {
                            <form hx-post="/settings/domains?handler=Verify" hx-target="#domains-list" hx-swap="innerHTML" style="display:inline;">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@domain.Id">
                                <select name="method" class="input-inline" title="Verification method">
                                    <option value="file">Verify via file</option>
                                    <option value="txt">Verify via DNS TXT</option>
                                </select>
                                <button type="submit" class="btn-sm">Verify</button>
                            </form>
                        }
                        @if (domain.IsVerified && !domain.IsDefault)
                        {
                            <form hx-post="/settings/domains?handler=SetDefault" hx-target="#domains-list" hx-swap="innerHTML" style="display:inline;">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@domain.Id">
                                <button type="submit" class="secondary btn-sm">Make default</button>
                            </form>
                        }
                        <form hx-post="/settings/domains?handler=Delete" hx-target="#domains-list" hx-swap="innerHTML" style="display:inline;">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@domain.Id">
                            <button type="submit" class="danger btn-sm">Delete</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
