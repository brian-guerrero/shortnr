@model List<GeoBreakdownItem>
@if (Model.Count == 0)
{
    <p style="text-align: center;">No geo data yet</p>
}
else
{
    <table>
        <thead>
            <tr>
                <th>Country</th>
                <th>Clicks</th>
                <th>Top Cities</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.CountryCode - @item.CountryName</td>
                    <td>@item.TotalClicks</td>
                    <td>
                        @if (item.CityCounts.Count == 0)
                        {
                            <span style="color: var(--pico-muted-color);">—</span>
                        }
                        else
                        {
                            @string.Join(", ", item.CityCounts.Select(c => $"{c.City} ({c.Count})"))
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
