@model List<ShortenedUrl>
@{
    var linkSort = Context.Request.Query["linkSort"].FirstOrDefault() ?? "";
    var linkDir = Context.Request.Query["linkDir"].FirstOrDefault() ?? "";

    var sortUrl = (string col, string dir) => "/dashboard?linkSort=" + col + "&linkDir=" + dir;

    void SortableHeader(string col, string label)
    {
        var isActive = linkSort == col;
        var isAsc = isActive && linkDir == "asc";
        var nextDir = isAsc ? "desc" : "asc";
        var ariaSort = !isActive ? "none" : isAsc ? "ascending" : "descending";
        <th class="@(isActive ? "sorted" : null)" aria-sort="@ariaSort"
            hx-get="@sortUrl(col, nextDir)" hx-target="#search-results" hx-swap="innerHTML"
            hx-include="#search-input, #domain-filter, #status-filter">
            @label
            @if (isActive)
            {
                <span class="sort-indicator" aria-hidden="true">@(isAsc ? "▲" : "▼")</span>
            }
        </th>
    }
}
@if (Model.Count == 0)
{
    <p style="text-align: center;">No results</p>
}
else
{
    <div class="overflow-auto">
        <table class="sortable">
            <thead>
                <tr>
                    @{
                        SortableHeader("shortCode", "Short URL");
                        SortableHeader("domain", "Domain");
                        SortableHeader("longUrl", "Original");
                        SortableHeader("clickCount", "Clicks");
                        SortableHeader("createdAtUtc", "Created");
                    }
                    <th>QR</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var link in Model)
                {
                    <tr class="@(link.IsArchived ? "archived-row" : null)">
                        <td>
                            <a href="@ShortUrlHelper.DisplayHref(Context.Request.Scheme, link.Domain?.Hostname, link.ShortCode)" target="_blank">@ShortUrlHelper.DisplayText(link.Domain?.Hostname, link.ShortCode)</a>
                            @if (link.IsArchived)
                            {
                                <mark class="status-neutral" style="margin-left: var(--sn-space-2);">archived</mark>
                            }
                        </td>
                        <td>@(link.Domain?.Hostname ?? "default")</td>
                        <td style="max-width: 300px; word-break: break-all;">@link.LongUrl</td>
                        <td>@link.ClickCount</td>
                        <td>@link.CreatedAtUtc.ToLocalTime().ToString("g")</td>
                        <td>
                            <span class="qr-wrap">
                                <button class="btn-sm" hx-get="/qr/@link.ShortCode" hx-target="closest .qr-wrap" hx-swap="innerHTML">QR</button>
                            </span>
                        </td>
                        <td>
                            <button class="btn-sm" hx-get="/dashboard?handler=Edit&code=@link.Id" hx-target="#link-edit-region" hx-swap="innerHTML">Edit</button>
                            @if (link.IsArchived)
                            {
                                <form hx-post="/dashboard?handler=Unarchive" hx-target="#search-results" hx-swap="innerHTML" style="display:inline;">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="code" value="@link.Id">
                                    <button type="submit" class="secondary btn-sm">Unarchive</button>
                                </form>
                            }
                            else
                            {
                                <form hx-post="/dashboard?handler=Archive" hx-target="#search-results" hx-swap="innerHTML" style="display:inline;">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="code" value="@link.Id">
                                    <button type="submit" class="secondary btn-sm">Archive</button>
                                </form>
                            }
                            <button class="btn-sm" hx-get="/dashboard?handler=Transfer&code=@link.Id" hx-target="#link-edit-region" hx-swap="innerHTML">Transfer</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
