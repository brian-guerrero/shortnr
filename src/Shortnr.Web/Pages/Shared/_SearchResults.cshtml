@model List<ShortenedUrl>
@{
    var linkSort = Context.Request.Query["linkSort"].FirstOrDefault() ?? "";
    var linkDir = Context.Request.Query["linkDir"].FirstOrDefault() ?? "";

    var scUrl = "/dashboard?linkSort=shortCode&linkDir=" + (linkSort == "shortCode" && linkDir == "asc" ? "desc" : "asc");
    var scInd = linkSort == "shortCode" ? linkDir == "asc" ? " ▲" : " ▼" : "";
    var dmUrl = "/dashboard?linkSort=domain&linkDir=" + (linkSort == "domain" && linkDir == "asc" ? "desc" : "asc");
    var dmInd = linkSort == "domain" ? linkDir == "asc" ? " ▲" : " ▼" : "";
    var luUrl = "/dashboard?linkSort=longUrl&linkDir=" + (linkSort == "longUrl" && linkDir == "asc" ? "desc" : "asc");
    var luInd = linkSort == "longUrl" ? linkDir == "asc" ? " ▲" : " ▼" : "";
    var ccUrl = "/dashboard?linkSort=clickCount&linkDir=" + (linkSort == "clickCount" && linkDir == "asc" ? "desc" : "asc");
    var ccInd = linkSort == "clickCount" ? linkDir == "asc" ? " ▲" : " ▼" : "";
    var caUrl = "/dashboard?linkSort=createdAtUtc&linkDir=" + (linkSort == "createdAtUtc" && linkDir == "asc" ? "desc" :
"asc");
    var caInd = linkSort == "createdAtUtc" ? linkDir == "asc" ? " ▲" : " ▼" : "";
}
@if (Model.Count == 0)
{
    <div class="sn-empty-state" role="status">No links match this search.</div>
}
else
{
    <div class="sn-table-wrap">
    <table class="sortable">
        <thead>
            <tr>
                <th hx-get="@scUrl" hx-target="#search-results" hx-swap="innerHTML" hx-include="#search-input, #domain-filter">Short URL
                    @scInd</th>
                <th hx-get="@dmUrl" hx-target="#search-results" hx-swap="innerHTML" hx-include="#search-input, #domain-filter">Domain
                    @dmInd</th>
                    <th hx-get="@luUrl" hx-target="#search-results" hx-swap="innerHTML" hx-include="#search-input, #domain-filter">Original
                        @luInd</th>
                        <th hx-get="@ccUrl" hx-target="#search-results" hx-swap="innerHTML" hx-include="#search-input, #domain-filter">Clicks @ccInd
                        </th>
                        <th hx-get="@caUrl" hx-target="#search-results" hx-swap="innerHTML" hx-include="#search-input, #domain-filter">Created
                            @caInd</th>
                        <th>QR</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var link in Model)
                        {
                            <tr>
                                <td>
                                    <a href="@ShortUrlHelper.DisplayHref(Context.Request.Scheme, link.Domain?.Hostname, link.ShortCode)" target="_blank">@ShortUrlHelper.DisplayText(link.Domain?.Hostname, link.ShortCode)</a>
                                </td>
                                <td>@(link.Domain?.Hostname ?? "default")</td>
                                <td class="sn-break">@link.LongUrl</td>
                                <td>@link.ClickCount</td>
                                <td>@link.CreatedAtUtc.ToLocalTime().ToString("g")</td>
                                <td>
                                    <span class="qr-wrap">
                                    <button hx-get="/qr/@link.ShortCode" hx-target="closest .qr-wrap" hx-swap="innerHTML" class="sn-compact-button">QR</button>
                                    </span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
                </div>
            }
