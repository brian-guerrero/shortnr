@model List<Shortnr.Web.Features.ClickTracking.LinkRowViewModel>
@inject Shortnr.Web.Features.Authentication.IUserIdentityService _admIdentity
@inject Shortnr.Web.Features.Workspaces.WorkspaceService _admWorkspaces
@{
    const string filters = "#search-input, #domain-filter, #status-filter";
    var selected = "[name='ids']:checked";
    var linkSort = Context.Request.Query["linkSort"].FirstOrDefault() ?? "";
    var linkDir = Context.Request.Query["linkDir"].FirstOrDefault() ?? "";
    var sort = TableSortState.FromQuery(
        Context.Request, "linkSort", "linkDir", "/dashboard", "#search-results", filters);
    var admOwnerId = await _admIdentity.ResolveOwnerUserIdAsync(User);
    var workspaceOptions = admOwnerId is null ? [] : await _admWorkspaces.GetWorkspacesForUserAsync(admOwnerId.Value);
}
@if (Model.Count == 0)
{
    <partial name="Shared/_EmptyState" model="@(new EmptyStateViewModel { Message = "No results", CssClass = "empty-state-centered" })" />
}
else
{
    <div class="bulk-toolbar" data-bulk-toolbar>
        <span class="bulk-count" data-bulk-count>0 selected</span>
        <button type="button" class="btn-sm" data-bulk-clear>Clear</button>
        <details class="dropdown bulk-actions-menu">
            <summary>Actions ▾</summary>
            <ul dir="rtl">
                <li>
                    <form class="inline-form" hx-post="/dashboard?handler=BulkArchive" hx-target="#search-results" hx-swap="innerHTML" hx-include="@(selected + ", " + filters)">
                        @Html.AntiForgeryToken()
                        <button type="submit">Archive</button>
                    </form>
                </li>
                <li>
                    <form class="inline-form" hx-post="/dashboard?handler=BulkUnarchive" hx-target="#search-results" hx-swap="innerHTML" hx-include="@(selected + ", " + filters)">
                        @Html.AntiForgeryToken()
                        <button type="submit">Restore</button>
                    </form>
                </li>
                @if (workspaceOptions.Count > 0)
                {
                    <li class="menu-section-label">Move to workspace</li>
                    <li>
                        <form class="bulk-menu-form" hx-post="/dashboard?handler=BulkMove" hx-target="#search-results" hx-swap="innerHTML" hx-include="@(selected + ", " + filters)">
                            @Html.AntiForgeryToken()
                            <select name="workspace" class="input-inline bulk-workspace-select" aria-label="Move to workspace">
                                <option value="">Choose…</option>
                                @foreach (var ws in workspaceOptions)
                                {
                                    <option value="@ws.Slug">@ws.Name</option>
                                }
                            </select>
                            <button type="submit">Move</button>
                        </form>
                    </li>
                }
                <li class="menu-section-label">Tags</li>
                <li>
                    <form class="bulk-menu-form bulk-tag-form" hx-post="/dashboard?handler=BulkTag" hx-target="#search-results" hx-swap="innerHTML" hx-include="@(selected + ", " + filters)">
                        @Html.AntiForgeryToken()
                        <input type="text" name="tags" class="input-inline" placeholder="Tag name…" aria-label="Add tag to selected links">
                        <button type="submit">Add</button>
                    </form>
                </li>
                <li>
                    <form class="bulk-menu-form" hx-post="/dashboard?handler=BulkUntag" hx-target="#search-results" hx-swap="innerHTML" hx-include="@(selected + ", " + filters)">
                        @Html.AntiForgeryToken()
                        <input type="text" name="tags" class="input-inline" placeholder="Tag name…" aria-label="Remove tag from selected links">
                        <button type="submit">Remove</button>
                    </form>
                </li>
            </ul>
        </details>
        <form class="inline-form bulk-delete" hx-post="/dashboard?handler=BulkDelete" hx-target="#search-results" hx-swap="innerHTML"
              hx-include="@(selected + ", " + filters)" hx-confirm="Delete the selected links?">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn-sm danger">Delete</button>
        </form>
    </div>
    <div class="overflow-auto">
        <table class="sortable">
            <thead>
                <tr>
                    <th class="select-col">
                        <input type="checkbox" id="select-all" data-select-all aria-label="Select all links">
                    </th>
                    <partial name="Shared/_SortableHeader" model="@sort.Header("shortCode", "Short URL")" />
                    <partial name="Shared/_SortableHeader" model="@sort.Header("domain", "Domain")" />
                    <partial name="Shared/_SortableHeader" model="@sort.Header("longUrl", "Original")" />
                    <th>Tags</th>
                    <partial name="Shared/_SortableHeader" model="@sort.Header("clickCount", "Clicks")" />
                    <partial name="Shared/_SortableHeader" model="@sort.Header("createdAtUtc", "Created")" />
                    <th>Last Clicked</th>
                    <th>QR</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var link in Model)
                {
                    <tr class="@(link.IsArchived ? "archived-row" : null)">
                        <td class="select-col">
                            <input type="checkbox" name="ids" value="@link.Id" data-select-row aria-label="Select @link.ShortCode">
                        </td>
                        <td>
                            <a href="@ShortUrlHelper.DisplayHref(Context.Request.Scheme, link.DomainHostname, link.ShortCode)" target="_blank">@link.DisplayText</a>
                            @if (link.IsArchived)
                            {
                                <partial name="Shared/_Badge" model="@(new BadgeViewModel { Kind = StatusKind.Neutral, Text = "archived", CssClass = "badge-gap" })" />
                            }
                        </td>
                        <td>@(link.DomainHostname.Length > 0 ? link.DomainHostname : "default")</td>
                        <td class="break-all-300">@link.LongUrl</td>
                        <td>
                            @if (link.Tags.Count > 0)
                            {
                                <span class="badge-group">
                                    @foreach (var tag in link.Tags.Take(3))
                                    {
                                        <partial name="Shared/_Badge" model="@(new BadgeViewModel { Kind = StatusKind.Plain, Text = tag, PreserveCase = true })" />
                                    }
                                    @if (link.Tags.Count > 3)
                                    {
                                        <span class="muted badge-more">+@(link.Tags.Count - 3)</span>
                                    }
                                </span>
                            }
                            else
                            {
                                <span class="muted">—</span>
                            }
                        </td>
                        <td>@link.ClickCount</td>
                        <td>@link.CreatedAtUtc.ToLocalTime().ToString("g")</td>
                        <td>@(link.LastClickedAtUtc?.ToLocalTime().ToString("g") ?? "—")</td>
                        <td>
                            <partial name="Shared/_QrTrigger" model="@(new QrTriggerViewModel { ShortCode = link.ShortCode })" />
                        </td>
                        <td>
                            <button class="btn-sm" hx-get="/dashboard?handler=Detail&code=@link.Id" hx-target="#link-detail" hx-swap="innerHTML" aria-label="View stats for @link.ShortCode">Stats</button>
                            <button class="btn-sm" hx-get="/dashboard?handler=Edit&code=@link.Id" hx-target="#link-edit-region" hx-swap="innerHTML">Edit</button>
                            <partial name="Shared/_ActionForm" model="@(new ActionFormViewModel
                            {
                                PostUrl = link.IsArchived ? "/dashboard?handler=Unarchive" : "/dashboard?handler=Archive",
                                Target = "#search-results",
                                HxInclude = filters,
                                HiddenFields =
                                {
                                    ["code"] = link.Id.ToString(),
                                    ["linkSort"] = linkSort,
                                    ["linkDir"] = linkDir
                                },
                                ButtonLabel = link.IsArchived ? "Unarchive" : "Archive"
                            })" />
                            <button class="btn-sm" hx-get="/dashboard?handler=Transfer&code=@link.Id" hx-target="#link-edit-region" hx-swap="innerHTML">Transfer</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}