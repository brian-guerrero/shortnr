@model Shortnr.Web.Pages.Settings.ApiKeysModel
@if (Model.ErrorMessage is not null)
{
    <mark style="display:block; margin-bottom: 1rem; background: var(--pico-del-color); color: var(--pico-color);">
        <strong>@Model.ErrorMessage</strong>
    </mark>
}
@if (Model.StatusMessage is not null)
{
    <mark style="display:block; margin-bottom: 1rem; background: var(--pico-ins-color); color: var(--pico-color);">
        <strong>@Model.StatusMessage</strong>
    </mark>
}
@if (Model.CreatedKey is not null)
{
    <mark style="display:block; margin-bottom: 1rem; background: var(--pico-mark-background-color); color: var(--pico-color);">
        <strong>Copy this now — it cannot be recovered later:</strong>
        <code style="display:block; margin-top: 0.5rem; word-break: break-all;">@Model.CreatedKey</code>
    </mark>
}
@if (Model.ApiKeys.Count == 0)
{
    <p>No API keys yet. Create one above to start using the API.</p>
}
else
{
    <table>
        <thead>
            <tr><th>Label</th><th>Key</th><th>Created</th><th>Last used</th><th>Status</th><th>Actions</th></tr>
        </thead>
        <tbody>
            @foreach (var key in Model.ApiKeys)
            {
                <tr>
                    <td>@key.Label</td>
                    <td><code>@key.KeyPrefix…</code></td>
                    <td><small>@key.CreatedAtUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</small></td>
                    <td>
                        <small>
                            @if (key.LastUsedAt is not null)
                            {
                                @key.LastUsedAt.Value.ToLocalTime().ToString("yyyy-MM-dd HH:mm")
                            }
                            else
                            {
                                <span style="color: var(--pico-muted-color);">never</span>
                            }
                        </small>
                    </td>
                    <td>
                        @if (key.RevokedAt is not null)
                        {
                            <mark>revoked</mark>
                        }
                        else
                        {
                            <mark style="background: var(--pico-ins-color); color: var(--pico-color);">active</mark>
                        }
                    </td>
                    <td>
                        @if (key.RevokedAt is null)
                        {
                            <form hx-post="/settings/api-keys?handler=Revoke" hx-target="#api-keys-list" hx-swap="innerHTML" style="display:inline;">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@key.Id">
                                <button type="submit" class="secondary" style="font-size: 0.75rem; padding: 0.2rem 0.5rem;">Revoke</button>
                            </form>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
