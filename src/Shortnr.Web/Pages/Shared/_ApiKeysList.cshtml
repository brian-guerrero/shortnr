@model Shortnr.Web.Pages.Settings.ApiKeysModel
@if (Model.ErrorMessage is not null)
{
    <mark class="sn-feedback sn-feedback-error" role="alert">
        <strong>@Model.ErrorMessage</strong>
    </mark>
}
@if (Model.StatusMessage is not null)
{
    <mark class="sn-feedback sn-feedback-success" role="status">
        <strong>@Model.StatusMessage</strong>
    </mark>
}
@if (Model.CreatedKey is not null)
{
    <mark class="sn-feedback sn-feedback-info" role="status">
        <strong>Copy this now — it cannot be recovered later:</strong>
        <code class="sn-break">@Model.CreatedKey</code>
    </mark>
}
@if (Model.ApiKeys.Count == 0)
{
    <div class="sn-empty-state" role="status">No API keys yet. Create one above to start using the API.</div>
}
else
{
    <div class="sn-table-wrap">
    <table class="sn-responsive-table">
        <thead>
            <tr><th>Label</th><th>Key</th><th>Scopes</th><th>Created</th><th>Last used</th><th>Status</th><th>Actions</th></tr>
        </thead>
        <tbody>
            @foreach (var key in Model.ApiKeys)
            {
                <tr>
                    <td data-label="Label">@key.Label</td>
                    <td data-label="Key"><code>@key.KeyPrefix…</code></td>
                    <td data-label="Scopes">
                        @foreach (var scope in Shortnr.Web.Services.ApiKeyScopes.Resolve(key.Scopes))
                        {
                            <mark class="pico-background-blue-100">@scope</mark>
                        }
                    </td>
                    <td data-label="Created"><small>@key.CreatedAtUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</small></td>
                    <td data-label="Last used">
                        <small>
                            @if (key.LastUsedAt is not null)
                            {
                                @key.LastUsedAt.Value.ToLocalTime().ToString("yyyy-MM-dd HH:mm")
                            }
                            else
                            {
                                <span class="sn-muted">never</span>
                            }
                        </small>
                    </td>
                    <td data-label="Status">
                        @if (key.RevokedAt is not null)
                        {
                            <mark>revoked</mark>
                        }
                        else
                        {
                            <mark class="pico-background-green-100">active</mark>
                        }
                    </td>
                    <td data-label="Actions" class="sn-action-cell">
                        @if (key.RevokedAt is null)
                        {
                            <form hx-post="/settings/api-keys?handler=Revoke" hx-target="#api-keys-list" hx-swap="innerHTML" style="display:inline;">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@key.Id">
                                <button type="submit" class="secondary sn-danger sn-compact-button">Revoke</button>
                            </form>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
    </div>
}
