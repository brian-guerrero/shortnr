@model Shortnr.Web.Pages.Settings.ApiKeysModel
<partial name="Shared/_StatusMessages" model="Model" />
@if (Model.CreatedKey is not null)
{
    <partial name="Shared/_Alert" model="@(new AlertViewModel { Kind = StatusKind.Info, Message = "Copy this now — it cannot be recovered later:", Detail = Model.CreatedKey })" />
}
@if (Model.ApiKeys.Count == 0)
{
    <partial name="Shared/_EmptyState" model="@(new EmptyStateViewModel { Message = "No API keys yet. Create one above to start using the API." })" />
}
else
{
    <table class="stacked-table">
        <thead>
            <tr><th>Label</th><th>Key</th><th>Scopes</th><th>Created</th><th>Last used</th><th>Status</th><th>Actions</th></tr>
        </thead>
        <tbody>
            @foreach (var key in Model.ApiKeys)
            {
                <tr>
                    <td data-label="Label">@key.Label</td>
                    <td data-label="Key"><code>@key.KeyPrefix…</code></td>
                    <td data-label="Scopes">
                        <partial name="Shared/_BadgeGroup" model="@(Shortnr.Web.Features.Authentication.ApiKeyScopes.Resolve(key.Scopes).Select(s => new BadgeViewModel { Kind = StatusKind.Info, Text = s }))" />
                    </td>
                    <td data-label="Created"><small>@key.CreatedAtUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</small></td>
                    <td data-label="Last used">
                        <small>
                            @if (key.LastUsedAt is not null)
                            {
                                @key.LastUsedAt.Value.ToLocalTime().ToString("yyyy-MM-dd HH:mm")
                            }
                            else
                            {
                                <span class="muted">never</span>
                            }
                        </small>
                    </td>
                    <td data-label="Status">
                        <partial name="Shared/_Badge" model="@(key.RevokedAt is not null
                            ? new BadgeViewModel { Kind = StatusKind.Neutral, Text = "revoked" }
                            : new BadgeViewModel { Kind = StatusKind.Success, Text = "active" })" />
                    </td>
                    <td data-label="Actions">
                        @if (key.RevokedAt is null)
                        {
                            <partial name="Shared/_ActionForm" model="@(new ActionFormViewModel
                            {
                                PostUrl = "/settings/api-keys?handler=Revoke",
                                Target = "#api-keys-list",
                                HiddenFields = { ["id"] = key.Id.ToString() },
                                ButtonLabel = "Revoke",
                                ButtonStyle = ActionButtonStyle.Danger,
                                ConfirmMessage = "Revoke this API key? Anything using it will stop working immediately."
                            })" />
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
