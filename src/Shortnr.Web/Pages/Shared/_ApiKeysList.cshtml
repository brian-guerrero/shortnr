@model Shortnr.Web.Pages.Settings.ApiKeysModel
@if (Model.ErrorMessage is not null)
{
    <mark class="banner status-error">
        <strong>@Model.ErrorMessage</strong>
    </mark>
}
@if (Model.StatusMessage is not null)
{
    <mark class="banner status-success">
        <strong>@Model.StatusMessage</strong>
    </mark>
}
@if (Model.CreatedKey is not null)
{
    <mark class="banner status-info">
        <strong>Copy this now — it cannot be recovered later:</strong>
        <code style="display:block; margin-top: 0.5rem; word-break: break-all;">@Model.CreatedKey</code>
    </mark>
}
@if (Model.ApiKeys.Count == 0)
{
    <p>No API keys yet. Create one above to start using the API.</p>
}
else
{
    <table class="stacked-table">
        <thead>
            <tr><th>Label</th><th>Key</th><th>Scopes</th><th>Created</th><th>Last used</th><th>Status</th><th>Actions</th></tr>
        </thead>
        <tbody>
            @foreach (var key in Model.ApiKeys)
            {
                <tr>
                    <td data-label="Label">@key.Label</td>
                    <td data-label="Key"><code>@key.KeyPrefix…</code></td>
                    <td data-label="Scopes">
                        <div class="badge-group">
                            @foreach (var scope in Shortnr.Web.Features.Authentication.ApiKeyScopes.Resolve(key.Scopes))
                            {
                                <mark class="status-info">@scope</mark>
                            }
                        </div>
                    </td>
                    <td data-label="Created"><small>@key.CreatedAtUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</small></td>
                    <td data-label="Last used">
                        <small>
                            @if (key.LastUsedAt is not null)
                            {
                                @key.LastUsedAt.Value.ToLocalTime().ToString("yyyy-MM-dd HH:mm")
                            }
                            else
                            {
                                <span class="muted">never</span>
                            }
                        </small>
                    </td>
                    <td data-label="Status">
                        @if (key.RevokedAt is not null)
                        {
                            <mark class="status-neutral">revoked</mark>
                        }
                        else
                        {
                            <mark class="status-success">active</mark>
                        }
                    </td>
                    <td data-label="Actions">
                        @if (key.RevokedAt is null)
                        {
                            <form hx-post="/settings/api-keys?handler=Revoke" hx-target="#api-keys-list" hx-swap="innerHTML" style="display:inline;">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@key.Id">
                                <button type="submit" class="danger btn-sm">Revoke</button>
                            </form>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
