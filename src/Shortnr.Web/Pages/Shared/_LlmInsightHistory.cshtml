@model Shortnr.Web.Pages.InsightsModel
@* Local-validation misses (bad short code/tag/URL) never reach the provider, so they're never
   persisted to history -- rendered here as a one-off banner instead of a history item. *@
@if (Model.TransientResult is not null)
{
    <mark class="banner status-error">
        <strong>@Model.TransientResult.FriendlyMessage</strong>
    </mark>
}
@if (Model.RecentRuns.Count == 0)
{
    if (Model.TransientResult is null)
    {
        <partial name="Shared/_EmptyState" model="@(new EmptyStateViewModel { Message = "No AI runs yet. Pick an action above and give it a try." })" />
    }
}
else
{
    <div class="stack-md">
        @foreach (var run in Model.RecentRuns)
        {
            <partial name="Shared/_LlmInsightHistoryItem" model="run" />
        }
    </div>
}
