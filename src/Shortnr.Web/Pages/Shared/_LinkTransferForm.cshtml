@model LinkTransferViewModel
<article class="edit-panel">
    @if (Model.ErrorMessage is not null)
    {
        <mark class="banner status-error">
            <strong>@Model.ErrorMessage</strong>
        </mark>
    }
    @if (Model.Workspaces.Count == 0)
    {
        <p>You are not a member of any workspace yet.</p>
    }
    else
    {
        <form method="post" hx-post="/dashboard?handler=Transfer"
              hx-target="#link-edit-region" hx-swap="innerHTML">
            @Html.AntiForgeryToken()
            <input type="hidden" name="code" value="@Model.Code">
            <fieldset>
                <label>
                    Current workspace
                    <input type="text" value="@Model.CurrentWorkspace" disabled>
                </label>
                <label>
                    Transfer to
                    <select name="workspace" required>
                        @foreach (var workspace in Model.Workspaces)
                        {
                            <option value="@workspace.Slug">@workspace.Name (@workspace.Slug)</option>
                        }
                    </select>
                </label>
            </fieldset>
            <div class="grid">
                <button type="submit" class="btn-sm">Transfer link</button>
                <button type="button" class="secondary btn-sm" onclick="document.getElementById('link-edit-region').innerHTML = ''">Cancel</button>
            </div>
        </form>
    }
</article>
