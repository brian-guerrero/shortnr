@model Shortnr.Web.Features.Insights.Llm.LlmInsightResult
@if (Model.IsSuccess)
{
    <mark class="banner status-info">
        <strong>AI-generated — verify before publishing.</strong>
    </mark>
    <p class="llm-result" style="white-space: pre-wrap;">@Model.Content</p>
}
else
{
    <mark class="banner @(Model.IsError ? "status-error" : "status-info")">
        <strong>@Model.FriendlyMessage</strong>
    </mark>
}