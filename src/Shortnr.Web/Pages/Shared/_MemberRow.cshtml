@using Shortnr.Data.Entities
@model WorkspaceMember
@{
    var workspaceId = (long?)ViewData["WorkspaceId"] ?? 0;
    var isPending = Model.JoinedAtUtc is null;
    var displayName = Model.User?.Name ?? Model.User?.Email ?? (isPending ? "Pending invite" : "Unknown");
}
<tr>
    <td data-label="Member">
        @if (isPending)
        {
            <em>@Model.InviteEmail</em>
        }
        else
        {
            @displayName
        }
    </td>
    <td data-label="Role">
        <form class="inline-form" hx-post="/settings/workspaces?handler=SetRole&id=@workspaceId&memberId=@Model.Id" hx-target="#workspaces-list" hx-swap="innerHTML">
            @Html.AntiForgeryToken()
            <select name="role" onchange="this.form.requestSubmit()">
                <option value="2" selected="@(Model.Role == WorkspaceRole.Owner)">Owner</option>
                <option value="1" selected="@(Model.Role == WorkspaceRole.Editor)">Editor</option>
                <option value="0" selected="@(Model.Role == WorkspaceRole.Viewer)">Viewer</option>
            </select>
        </form>
    </td>
    <td data-label="Joined">
        @if (isPending)
        {
            <partial name="Shared/_Badge" model="@(new BadgeViewModel { Kind = StatusKind.Info, Text = "Pending" })" />
        }
        else
        {
            @Model.JoinedAtUtc?.ToLocalTime().ToString("d")
        }
    </td>
    <td data-label="Actions">
        @if (isPending)
        {
            <partial name="Shared/_ActionForm" model="@(new ActionFormViewModel
            {
                PostUrl = $"/settings/workspaces?handler=ResendInvite&id={workspaceId}&memberId={Model.Id}",
                Target = "#workspaces-list",
                ButtonLabel = "Resend"
            })" />
        }
        <partial name="Shared/_ActionForm" model="@(new ActionFormViewModel
        {
            PostUrl = $"/settings/workspaces?handler=RemoveMember&id={workspaceId}&memberId={Model.Id}",
            Target = "#workspaces-list",
            ButtonLabel = "Remove"
        })" />
    </td>
</tr>
