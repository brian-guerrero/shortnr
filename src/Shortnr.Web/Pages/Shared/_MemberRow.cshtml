@using Shortnr.Data.Entities
@model WorkspaceMember
@{
    var workspaceId = (long?)ViewData["WorkspaceId"] ?? 0;
    var isPending = Model.JoinedAtUtc is null;
    var displayName = Model.User?.Name ?? Model.User?.Email ?? (isPending ? "Pending invite" : "Unknown");
}
<tr>
    <td data-label="Member">
        @if (isPending)
        {
            <em>@Model.InviteEmail</em>
        }
        else
        {
            @displayName
        }
    </td>
    <td data-label="Role">
        <form hx-post="/settings/workspaces?handler=SetRole&id=@workspaceId&memberId=@Model.Id" hx-target="#workspaces-list" hx-swap="innerHTML" style="margin: 0;">
            @Html.AntiForgeryToken()
            <select name="role" onchange="this.form.requestSubmit()">
                <option value="2" selected="@(Model.Role == WorkspaceRole.Owner)">Owner</option>
                <option value="1" selected="@(Model.Role == WorkspaceRole.Editor)">Editor</option>
                <option value="0" selected="@(Model.Role == WorkspaceRole.Viewer)">Viewer</option>
            </select>
        </form>
    </td>
    <td data-label="Joined">
        @if (isPending)
        {
            <mark class="status-info">Pending</mark>
        }
        else
        {
            @Model.JoinedAtUtc?.ToLocalTime().ToString("d")
        }
    </td>
    <td data-label="Actions">
        @if (isPending)
        {
            <form hx-post="/settings/workspaces?handler=ResendInvite&id=@workspaceId&memberId=@Model.Id" hx-target="#workspaces-list" hx-swap="innerHTML" style="margin: 0; display: inline;">
                @Html.AntiForgeryToken()
                <button type="submit" class="secondary btn-sm">Resend</button>
            </form>
        }
        <form hx-post="/settings/workspaces?handler=RemoveMember&id=@workspaceId&memberId=@Model.Id" hx-target="#workspaces-list" hx-swap="innerHTML" style="margin: 0; display: inline;">
            @Html.AntiForgeryToken()
            <button type="submit" class="secondary btn-sm">Remove</button>
        </form>
    </td>
</tr>
