@using Shortnr.Data.Entities
@model WorkspaceMember
@{
    var workspaceId = (long?)ViewData["WorkspaceId"] ?? 0;
    var isPending = Model.JoinedAtUtc is null;
    var displayName = Model.User?.Name ?? Model.User?.Email ?? (isPending ? "Pending invite" : "Unknown");
}
<tr>
    <td>
        @if (isPending)
        {
            <em>@Model.InviteEmail</em>
        }
        else
        {
            @displayName
        }
    </td>
    <td>
        @if (Model.Role == WorkspaceRole.Owner)
        {
            <span class="pico-background-green-100" style="padding: 0.1rem 0.4rem; border-radius: 0.25rem; font-size: 0.8rem;">Owner</span>
        }
        else
        {
            <form hx-post="/settings/workspaces?handler=SetRole&id=@workspaceId&userId=@Model.UserId" hx-target="#workspaces-list" hx-swap="innerHTML" style="margin: 0;">
                @Html.AntiForgeryToken()
                <select name="role" onchange="this.form.requestSubmit()">
                    <option value="2" selected="@(Model.Role == WorkspaceRole.Owner)">Owner</option>
                    <option value="1" selected="@(Model.Role == WorkspaceRole.Editor)">Editor</option>
                    <option value="0" selected="@(Model.Role == WorkspaceRole.Viewer)">Viewer</option>
                </select>
            </form>
        }
    </td>
    <td>
        @if (isPending)
        {
            <span class="pico-background-blue-100" style="padding: 0.1rem 0.4rem; border-radius: 0.25rem; font-size: 0.8rem;">Pending</span>
        }
        else
        {
            @Model.JoinedAtUtc?.ToLocalTime().ToString("d")
        }
    </td>
    <td>
        @if (Model.Role != WorkspaceRole.Owner)
        {
            <form hx-post="/settings/workspaces?handler=RemoveMember&id=@workspaceId&userId=@Model.UserId" hx-target="#workspaces-list" hx-swap="innerHTML" style="margin: 0;">
                @Html.AntiForgeryToken()
                <button type="submit" class="secondary" style="padding: 0.2rem 0.5rem; font-size: 0.8rem;">Remove</button>
            </form>
        }
    </td>
</tr>
