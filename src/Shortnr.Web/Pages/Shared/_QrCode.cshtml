@model Shortnr.Web.Models.QrCodeViewModel
<figure class="sn-qr-inline">
    <img src="@Model.DataUri" alt="QR code for /@Model.ShortCode" width="160" height="160"
         class="sn-qr-image">
    <figcaption class="sn-muted">
        <a href="/api/qr/@Model.ShortCode" download="qr-@(Model.ShortCode).png">Download</a>
    </figcaption>
</figure>
