@model Shortnr.Web.Features.ShortLinks.Models.PostResultViewModel
@if (Model.HasError)
{
    <partial name="Shared/_Alert" model="@(new AlertViewModel { Kind = StatusKind.Error, Message = Model.ErrorMessage!, Style = "margin-top: var(--sn-space-4);" })" />
}
else
{
    <ins class="block stack-md">
        <strong>Short URL:</strong>
        <a href="@Model.ShortUrl" target="_blank">@Model.ShortUrl</a>
        <partial name="Shared/_QrTrigger" model="@(new QrTriggerViewModel { ShortCode = Model.ShortCode, Label = "Show QR", WrapCssClass = "qr-wrap-inline" })" />
    </ins>
}
<section id="recent" hx-swap-oob="true">
    <partial name="Shared/_RecentLinksTable" model="Model.RecentLinks" />
</section>
