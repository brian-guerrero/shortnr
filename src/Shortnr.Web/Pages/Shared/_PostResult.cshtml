@model Shortnr.Web.Models.PostResultViewModel
@if (Model.HasError)
{
    <mark class="sn-feedback sn-feedback-error" role="alert">
        <strong>@Model.ErrorMessage</strong>
    </mark>
}
else
{
    <ins class="sn-result" role="status">
        <strong>Short URL:</strong>
        <a href="@Model.ShortUrl" target="_blank">@Model.ShortUrl</a>
        <span class="qr-wrap">
            <button hx-get="/qr/@Model.ShortCode" hx-target="closest .qr-wrap" hx-swap="innerHTML" class="sn-compact-button">Show QR</button>
        </span>
    </ins>
}
<section id="recent" hx-swap-oob="true">
    <h2>Recent links</h2>
    <table>
        <thead>
            <tr><th>Short URL</th><th>Original</th><th>Clicks</th><th>QR</th></tr>
        </thead>
        <tbody>
            @foreach (var link in Model.RecentLinks)
            {
                <tr>
                    <td><a href="@link.DisplayUrl()" target="_blank">@link.DisplayText()</a></td>
                    <td class="sn-break">@link.LongUrl</td>
                    <td>@link.ClickCount</td>
                    <td>
                        <span class="qr-wrap">
                            <button hx-get="/qr/@link.ShortCode" hx-target="closest .qr-wrap" hx-swap="innerHTML" class="sn-compact-button">QR</button>
                        </span>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</section>
