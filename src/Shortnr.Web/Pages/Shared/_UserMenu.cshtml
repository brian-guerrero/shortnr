@using System.Security.Claims
@inject Shortnr.Web.Features.Authentication.IUserIdentityService _identity
@inject Shortnr.Web.Features.Workspaces.WorkspaceService _workspaceService

@{
    var email     = User.FindFirstValue(ClaimTypes.Email) ?? User.FindFirstValue("email");
    var name      = User.Identity?.Name ?? email ?? "Account";
    var avatarUrl = GravatarHelper.Url(email, size: 36);
    var userId    = await _identity.ResolveOwnerUserIdAsync(User);
    var workspaces = userId is not null ? await _workspaceService.GetWorkspacesForUserAsync(userId.Value) : [];
    var workspaceCtx = await _identity.ResolveActiveWorkspaceContextAsync(User);
}

<details class="dropdown user-menu">
    <summary>
        <img src="@avatarUrl" alt="" class="nav-avatar" width="36" height="36" />
        @name
    </summary>
    <ul dir="rtl">
        @if (workspaces.Count > 0)
        {
            <li class="menu-section-label">Workspaces</li>
            @if (workspaceCtx is not null)
            {
                <li class="menu-active-workspace"><mark class="status-info preserve-case">@workspaceCtx.Name</mark></li>
            }
            @foreach (var ws in workspaces)
            {
                <li>
                    <form method="post" action="/workspace/switch" style="margin: 0; display: inline;">
                        <input type="hidden" name="slug" value="@ws.Slug">
                        <button type="submit" class="@(workspaceCtx?.WorkspaceId == ws.Id ? "is-active" : null)">@ws.Name</button>
                    </form>
                </li>
            }
            <li>
                <form method="post" action="/workspace/switch" style="margin: 0; display: inline;">
                    <input type="hidden" name="slug" value="personal">
                    <button type="submit" class="@(workspaceCtx is null ? "is-active" : null)">Personal</button>
                </form>
            </li>
            <li><hr style="margin: 0.25rem 0;"></li>
        }
        <li><a href="/settings/api-keys">Settings</a></li>
        <li><a href="/account/logout">Log out</a></li>
    </ul>
</details>
