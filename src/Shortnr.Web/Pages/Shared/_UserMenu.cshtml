@using System.Security.Claims
@inject Shortnr.Web.Services.UserIdentityService _identity
@inject Shortnr.Web.Services.WorkspaceService _workspaceService

@{
    var email     = User.FindFirstValue(ClaimTypes.Email) ?? User.FindFirstValue("email");
    var name      = User.Identity?.Name ?? email ?? "Account";
    var avatarUrl = GravatarHelper.Url(email, size: 36);
    var avatarInitial = name.Length > 0 ? name[..1].ToUpperInvariant() : "?";
    var userId    = await _identity.ResolveOwnerUserIdAsync(User);
    var workspaces = userId is not null ? await _workspaceService.GetWorkspacesForUserAsync(userId.Value) : [];
    var workspaceCtx = await _identity.ResolveActiveWorkspaceContextAsync(User);
}

<details class="dropdown sn-user-menu">
    <summary>
        <span class="sn-avatar" aria-hidden="true">
            <span class="sn-avatar-fallback">@avatarInitial</span>
            <img src="@avatarUrl" alt="" class="nav-avatar" width="36" height="36" onerror="this.hidden = true; this.previousElementSibling.hidden = false;" />
        </span>
        @name
    </summary>
    <ul dir="rtl">
        @if (workspaces.Count > 0)
        {
            <li class="workspace-section-header sn-muted">Workspaces</li>
            @if (workspaceCtx is not null)
            {
                <li><mark class="pico-background-blue-100">@workspaceCtx.Name</mark></li>
            }
            @foreach (var ws in workspaces)
            {
                <li>
                    <form method="post" action="/workspace/switch">
                        <input type="hidden" name="slug" value="@ws.Slug">
                        <button type="submit" class="secondary sn-menu-action @(workspaceCtx?.WorkspaceId == ws.Id ? "sn-menu-action-active" : "")">@ws.Name</button>
                    </form>
                </li>
            }
            <li>
                    <form method="post" action="/workspace/switch">
                    <input type="hidden" name="slug" value="personal">
                    <button type="submit" class="secondary sn-menu-action @(workspaceCtx is null ? "sn-menu-action-active" : "")">Personal</button>
                </form>
            </li>
            <li><hr></li>
        }
        <li><a href="/settings/api-keys">Settings</a></li>
        <li><a href="/account/logout">Log out</a></li>
    </ul>
</details>
