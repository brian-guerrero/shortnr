@model List<Shortnr.Web.Models.AiActivityRow>
@if (Model.Count == 0)
{
    <div class="sn-empty-state" role="status">
        <p>No AI activity yet. Actions performed through the MCP API (create, update, delete links,
        bio page edits) will appear here.</p>
    </div>
}
else
{
    <div class="sn-table-wrap">
    <table role="grid">
        <thead>
            <tr>
                <th>When</th>
                <th>Action</th>
                <th>Summary</th>
                <th>API key</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var row in Model)
            {
                <tr>
                    <td>@row.CreatedAtUtc.ToLocalTime().ToString("g")</td>
                    <td><code>@row.Action</code></td>
                    <td>@row.Summary</td>
                    <td>@(row.ApiKeyLabel ?? "—")</td>
                </tr>
            }
        </tbody>
    </table>
    </div>
}
