@model Shortnr.Web.Pages.Settings.WebhooksModel
@if (Model.ErrorMessage is not null)
{
    <mark class="sn-feedback sn-feedback-error" role="alert">
        <strong>@Model.ErrorMessage</strong>
    </mark>
}
@if (Model.StatusMessage is not null)
{
    <mark class="sn-feedback sn-feedback-success" role="status">
        <strong>@Model.StatusMessage</strong>
    </mark>
}
@if (Model.CreatedSecret is not null)
{
    <mark class="sn-feedback sn-feedback-info" role="status">
        <strong>Copy this secret now — it cannot be recovered later:</strong>
        <code class="sn-break">@Model.CreatedSecret</code>
    </mark>
}
@if (Model.Webhooks.Count == 0)
{
    <div class="sn-empty-state" role="status">No webhooks yet. Create one above to start receiving event notifications.</div>
}
else
{
    <div class="sn-table-wrap">
    <table class="sn-responsive-table">
        <thead>
            <tr><th>URL</th><th>Events</th><th>Created</th><th>Status</th><th>Actions</th></tr>
        </thead>
        <tbody>
            @foreach (var webhook in Model.Webhooks)
            {
                <tr>
                    <td data-label="URL" class="sn-break"><small>@webhook.Url</small></td>
                    <td data-label="Events">
                        @foreach (var eventType in Shortnr.Web.Services.WebhookEventTypes.Parse(webhook.EventTypes))
                        {
                            <mark class="pico-background-blue-100">@eventType</mark>
                        }
                    </td>
                    <td data-label="Created"><small>@webhook.CreatedAtUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</small></td>
                    <td data-label="Status">
                        @if (!webhook.IsActive)
                        {
                            <mark class="pico-background-red-100">disabled</mark>
                            @if (webhook.FailureCount > 0)
                            {
                                <small class="sn-muted">@webhook.FailureCount failures</small>
                            }
                        }
                        else
                        {
                            <mark class="pico-background-green-100">active</mark>
                        }
                    </td>
                    <td data-label="Actions" class="sn-action-cell">
                        @if (webhook.IsActive)
                        {
                            <form hx-post="/settings/webhooks?handler=Revoke" hx-target="#webhooks-list" hx-swap="innerHTML" style="display:inline;">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@webhook.Id">
                                <button type="submit" class="secondary sn-compact-button">Disable</button>
                            </form>
                        }
                        else
                        {
                            <form hx-post="/settings/webhooks?handler=Activate" hx-target="#webhooks-list" hx-swap="innerHTML" style="display:inline;">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@webhook.Id">
                                <button type="submit" class="sn-compact-button">Re-enable</button>
                            </form>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
    </div>
}
