@model Shortnr.Web.Pages.Settings.WebhooksModel
<partial name="Shared/_StatusMessages" model="Model" />
@if (Model.CreatedSecret is not null)
{
    <partial name="Shared/_Alert" model="@(new AlertViewModel { Kind = StatusKind.Info, Message = "Copy this secret now — it cannot be recovered later:", Detail = Model.CreatedSecret })" />
}
@if (Model.Webhooks.Count == 0)
{
    <partial name="Shared/_EmptyState" model="@(new EmptyStateViewModel { Message = "No webhooks yet. Create one above to start receiving event notifications." })" />
}
else
{
    <div class="overflow-auto">
        <table class="stacked-table">
            <thead>
                <tr><th>URL</th><th>Events</th><th>Created</th><th>Status</th><th>Actions</th></tr>
            </thead>
            <tbody>
                @foreach (var webhook in Model.Webhooks)
                {
                    <tr>
                        <td data-label="URL"><small class="break-all">@webhook.Url</small></td>
                        <td data-label="Events">
                            <partial name="Shared/_BadgeGroup" model="@(Shortnr.Web.Features.Webhooks.WebhookEventTypes.Parse(webhook.EventTypes).Select(e => new BadgeViewModel { Kind = StatusKind.Info, Text = e }))" />
                        </td>
                        <td data-label="Created"><small>@webhook.CreatedAtUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</small></td>
                        <td data-label="Status">
                            <partial name="Shared/_Badge" model="@(webhook.IsActive
                                ? new BadgeViewModel { Kind = StatusKind.Success, Text = "active" }
                                : new BadgeViewModel { Kind = StatusKind.Error, Text = "disabled" })" />
                            @if (!webhook.IsActive && webhook.FailureCount > 0)
                            {
                                <small class="block">@webhook.FailureCount failures</small>
                            }
                        </td>
                        <td data-label="Actions">
                            <partial name="Shared/_ActionForm" model="@(webhook.IsActive
                                ? new ActionFormViewModel
                                {
                                    PostUrl = "/settings/webhooks?handler=Revoke",
                                    Target = "#webhooks-list",
                                    HiddenFields = { ["id"] = webhook.Id.ToString() },
                                    ButtonLabel = "Disable"
                                }
                                : new ActionFormViewModel
                                {
                                    PostUrl = "/settings/webhooks?handler=Activate",
                                    Target = "#webhooks-list",
                                    HiddenFields = { ["id"] = webhook.Id.ToString() },
                                    ButtonLabel = "Re-enable"
                                })" />
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
