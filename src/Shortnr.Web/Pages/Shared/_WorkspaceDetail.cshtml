@using Shortnr.Data.Entities
@model Shortnr.Web.Pages.Settings.WorkspaceDetailViewModel
@{
    var members = Model.Members;
    var workspaceId = Model.WorkspaceId;
    var workspaceSlug = Model.WorkspaceSlug;
}
<div class="sn-table-wrap">
<table class="sn-responsive-table">
    <thead>
        <tr>
            <th>Member</th>
            <th>Role</th>
            <th>Joined</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var m in members)
        {
            @await Html.PartialAsync("Shared/_MemberRow", m, new ViewDataDictionary(ViewData) { ["WorkspaceId"] = workspaceId })
        }
    </tbody>
</table>
</div>

@if (members.Any(m => m.Role == WorkspaceRole.Owner && m.JoinedAtUtc != null))
{
    <details>
        <summary class="secondary outline">Invite member</summary>
        <form hx-post="/settings/workspaces?handler=Invite&id=@workspaceId" hx-target="#workspaces-list" hx-swap="innerHTML"
              hx-on::after-request="if (event.detail.successful) { this.querySelector('input[name=email]').value = ''; }">
            @Html.AntiForgeryToken()
            <div class="grid">
                <label>
                    Email
                    <input type="email" name="email" placeholder="colleague@example.com" required>
                </label>
                <label>
                    Role
                    <select name="role">
                        <option value="1">Editor</option>
                        <option value="0">Viewer</option>
                    </select>
                </label>
            </div>
            <button type="submit">Invite</button>
        </form>
    </details>
}

<form hx-post="/settings/workspaces?handler=Delete&id=@workspaceId" hx-target="#workspaces-list" hx-swap="innerHTML"
      hx-confirm="Permanently delete this workspace? This cannot be undone.">
    @Html.AntiForgeryToken()
    <button type="submit" class="secondary sn-danger">Delete workspace</button>
</form>

<p class="sn-muted"><small>Set this as your active workspace from the user menu in the top bar.</small></p>
