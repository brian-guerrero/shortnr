@using Shortnr.Data.Entities
@{
    var members = ViewData["Members"] as List<WorkspaceMember> ?? [];
    var workspaceId = (long)ViewData["WorkspaceId"]!;
    var workspaceSlug = ViewData["WorkspaceSlug"] as string ?? "";
}
<table>
    <thead>
        <tr>
            <th>Member</th>
            <th>Role</th>
            <th>Joined</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var m in members)
        {
            @await Html.PartialAsync("Shared/_MemberRow", m)
        }
    </tbody>
</table>

@if (members.Any(m => m.Role == WorkspaceRole.Owner && m.JoinedAtUtc != null))
{
    <details>
        <summary role="button" class="secondary outline" style="width: auto;">Invite member</summary>
        <form hx-post="/settings/workspaces?handler=Invite&id=@workspaceId" hx-target="#workspaces-list" hx-swap="innerHTML"
              hx-on::after-request="if (event.detail.successful) { this.querySelector('input[name=email]').value = ''; }">
            @Html.AntiForgeryToken()
            <div class="grid">
                <label>
                    Email
                    <input type="email" name="email" placeholder="colleague@example.com" required>
                </label>
                <label>
                    Role
                    <select name="role">
                        <option value="1">Editor</option>
                        <option value="0">Viewer</option>
                    </select>
                </label>
            </div>
            <button type="submit">Invite</button>
        </form>
    </details>
}

<form hx-post="/settings/workspaces?handler=Delete&id=@workspaceId" hx-target="#workspaces-list" hx-swap="innerHTML"
      hx-confirm="Permanently delete this workspace? This cannot be undone." style="margin-top: 1rem;">
    @Html.AntiForgeryToken()
    <button type="submit" class="secondary">Delete workspace</button>
</form>

<p style="margin-top: 0.5rem;"><small>Set this as your active workspace from the user menu in the top bar.</small></p>
