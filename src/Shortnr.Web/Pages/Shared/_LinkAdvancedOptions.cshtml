@model LinkAdvancedOptionsViewModel
@inject Shortnr.Web.Features.Theming.IThemeResolver ThemeResolver
@{
    var previewThemes = await ThemeResolver.GetAllThemesAsync();
}
<button type="button" class="secondary" style="margin-bottom: 0.75rem;"
        @@click="showAdvanced = !showAdvanced" aria-expanded="false" :aria-expanded="showAdvanced ? 'true' : 'false'">
    <span x-text="showAdvanced ? 'Hide advanced options' : 'Advanced options'"></span>
</button>
<div x-show="showAdvanced" x-cloak class="advanced-panel">
    <p class="muted advanced-note">All fields below are optional.</p>

    @if (Model.ShowCustomCode)
    {
        <fieldset class="field-section">
            <legend>Link identity</legend>
            <div class="field">
                <label for="slug">Custom code</label>
                <input type="text" name="slug" id="slug" value="@Model.Slug" placeholder="my-custom-code"
                       pattern="[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}" maxlength="64">
            </div>
        </fieldset>
    }

    <fieldset class="field-section">
        <legend>Campaign tracking (UTM)</legend>
        <div class="field-grid">
            <div class="field">
                <label for="utm_source">UTM source</label>
                <input type="text" name="utm_source" id="utm_source" value="@Model.UtmSource" placeholder="newsletter" maxlength="512">
            </div>
            <div class="field">
                <label for="utm_medium">UTM medium</label>
                <input type="text" name="utm_medium" id="utm_medium" value="@Model.UtmMedium" placeholder="email" maxlength="512">
            </div>
            <div class="field">
                <label for="utm_campaign">UTM campaign</label>
                <input type="text" name="utm_campaign" id="utm_campaign" value="@Model.UtmCampaign" placeholder="spring-sale-2026" maxlength="512">
            </div>
            <div class="field">
                <label for="utm_term">UTM term</label>
                <input type="text" name="utm_term" id="utm_term" value="@Model.UtmTerm" placeholder="running-shoes" maxlength="512">
            </div>
            <div class="field field-span">
                <label for="utm_content">UTM content</label>
                <input type="text" name="utm_content" id="utm_content" value="@Model.UtmContent" placeholder="hero-banner" maxlength="512">
            </div>
        </div>
    </fieldset>

    <fieldset class="field-section">
        <legend>Retargeting pixel</legend>
        <div class="field">
            <label for="pixel_type">Pixel type</label>
            <select name="pixel_type" id="pixel_type"
                    @@change="showPixel = $event.target.value !== ''; pixelIsCustom = $event.target.selectedOptions[0]?.dataset.custom === 'true'">
                <option value="">None</option>
                @foreach (var snippet in Model.PixelSnippets)
                {
                    <option value="@snippet.Id" data-custom="@snippet.IsCustom.ToString().ToLowerInvariant()" selected="@(Model.PixelSnippetId == snippet.Id)">@snippet.Name</option>
                }
            </select>
        </div>
        <div x-show="showPixel" x-cloak class="field-reveal">
            <template x-if="!pixelIsCustom">
                <div class="field">
                    <label for="pixel_id">Pixel ID <small>(for Meta/Google templates)</small></label>
                    <input type="text" name="pixel_id" id="pixel_id" value="@Model.PixelId" placeholder="e.g. 1234567890123" maxlength="256">
                </div>
            </template>
            <template x-if="pixelIsCustom">
                <div class="field">
                    <label for="pixel_snippet">Custom snippet HTML <small>(for custom snippets)</small></label>
                    <textarea name="pixel_snippet" id="pixel_snippet" rows="6" maxlength="8192" placeholder="&lt;script&gt;…&lt;/script&gt;">@Model.PixelSnippetHtml</textarea>
                </div>
            </template>
        </div>
    </fieldset>

    <fieldset class="field-section">
        <legend>Mobile deep links</legend>
        <div class="field-grid">
            <div class="field">
                <label for="ios_deep_link">iOS deep link <small>(App Store / URI scheme)</small></label>
                <input type="text" name="ios_deep_link" id="ios_deep_link" value="@Model.IosDeepLink" maxlength="2048"
                       placeholder="https://apps.apple.com/app/id123456789 or myapp://open">
            </div>
            <div class="field">
                <label for="android_deep_link">Android deep link <small>(Play Store / app link)</small></label>
                <input type="text" name="android_deep_link" id="android_deep_link" value="@Model.AndroidDeepLink" maxlength="2048"
                       placeholder="https://play.google.com/store/apps/details?id=com.example.app">
            </div>
        </div>
    </fieldset>

    <fieldset class="field-section">
        <legend>Preview theme</legend>
        <div class="field">
            <label for="preview_theme">Redirect preview style <small>(shown when visitors click the link)</small></label>
            <select name="preview_theme" id="preview_theme">
                <option value="" selected="@(Model.PreviewTheme == "")">No preview</option>
                @foreach (var theme in previewThemes)
                {
                    <option value="@theme.Id" selected="@(Model.PreviewTheme == theme.Id)">@theme.Label</option>
                }
            </select>
        </div>
    </fieldset>
</div>
