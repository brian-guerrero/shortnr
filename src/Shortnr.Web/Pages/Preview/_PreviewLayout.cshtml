@{
    var theme = (string?)ViewData["PreviewTheme"] ?? "minimal";
    var title = (string?)ViewData["PreviewTitle"] ?? "Redirecting…";
    var themeFile = $"css/themes/preview-{theme}.css";
}
<!DOCTYPE html>
<html lang="en" data-preview-theme="@theme" data-color-scheme="@(theme == "dark" ? "dark" : "light")">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex">
    <title>@title</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="/css/site.css">
    <link rel="stylesheet" href="/@themeFile">
    <style>
        body {
            background: var(--pv-bg);
            color: var(--pv-fg);
            margin: 0;
            min-height: 100vh;
            font-family: var(--pv-font-body);
        }
        .pv-shell {
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 3rem 1rem;
            min-height: 100vh;
            box-sizing: border-box;
        }
        .pv-card {
            background: var(--pv-card);
            width: 100%;
            max-width: 480px;
            border-radius: var(--pv-radius);
            padding: 2rem;
            box-shadow: var(--pv-shadow);
            text-align: center;
        }
        .pv-destination {
            word-break: break-all;
            font-size: 1.125rem;
            margin: 0 0 1rem;
            color: var(--pv-fg);
            font-family: var(--pv-font-heading);
        }
        .pv-domain {
            display: inline-block;
            padding: 0.25rem 0.75rem;
            background: var(--pv-accent);
            color: var(--pv-accent-fg);
            border-radius: var(--pv-radius);
            font-size: 0.875rem;
            font-weight: 600;
            margin-bottom: 1.5rem;
        }
        .pv-proceed {
            display: inline-block;
            padding: 0.75rem 1.5rem;
            background: var(--pv-accent);
            color: var(--pv-accent-fg);
            text-decoration: none;
            border-radius: var(--pv-radius);
            font-weight: 600;
            font-size: 1rem;
            margin-top: 0.5rem;
        }
        .pv-proceed:hover {
            opacity: 0.9;
        }
        .pv-muted {
            color: var(--pv-muted);
            font-size: 0.875rem;
            margin-top: 1rem;
        }
        .pv-brand {
            font-size: 0.75rem;
            color: var(--pv-muted);
            margin-top: 1.5rem;
        }
        .pv-brand a {
            color: var(--pv-muted);
            text-decoration: underline;
        }

        [data-preview-theme="brutal"] .pv-card {
            border: var(--pv-border-width, 3px) solid var(--pv-border);
            box-shadow: var(--pv-shadow-lg, 8px 8px 0 var(--pv-border));
        }
        [data-preview-theme="brutal"] .pv-domain {
            border: var(--pv-border-width, 3px) solid var(--pv-border);
            font-family: var(--pv-font-heading);
            font-weight: 900;
        }
        [data-preview-theme="brutal"] .pv-proceed {
            border: var(--pv-border-width, 3px) solid var(--pv-border);
            box-shadow: var(--pv-shadow, 4px 4px 0 var(--pv-border));
            font-family: var(--pv-font-heading);
            font-weight: 900;
            transition: transform 0.1s, box-shadow 0.1s;
        }
        [data-preview-theme="brutal"] .pv-proceed:hover {
            opacity: 1;
            transform: translate(1px, 1px);
            box-shadow: 3px 3px 0 var(--pv-border);
        }
        [data-preview-theme="brutal"] .pv-proceed:active {
            transform: translate(3px, 3px);
            box-shadow: var(--pv-shadow-active, 1px 1px 0 var(--pv-border));
        }
    </style>
</head>

<body>
    <div class="pv-shell">
        @RenderBody()
    </div>
</body>

</html>
