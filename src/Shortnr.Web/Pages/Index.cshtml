@page
@model IndexModel
@{
    Layout = Model.IsHtmxRequest ? null : "_Layout";
}
<div class="sn-home">
    <section class="sn-hero" aria-labelledby="home-title">
        <div class="sn-hero-copy">
            <p class="sn-kicker">Link infrastructure you own</p>
            <h1 id="home-title">Make every link count.</h1>
            <p>Shorten, track, and share links from infrastructure you control. No vendor lock-in. No per-click anxiety.</p>
            @if (Model.Workspace is not null)
            {
                @await Html.PartialAsync("Shared/_WorkspaceBadge", Model.Workspace)
            }
        </div>
        <div class="sn-hero-art" aria-label="shortnr system status">
            <div class="sn-art-tile">OWN<br>YOUR<br>CLICKS<br><span aria-hidden="true">//</span> READY</div>
        </div>
    </section>

    <section class="sn-editorial-band sn-band-violet" aria-labelledby="why-shortnr-heading">
        <div class="sn-band-heading">
            <p class="sn-kicker">The shortnr difference</p>
            <h2 id="why-shortnr-heading">A link platform that stays yours.</h2>
        </div>
        <div class="sn-card-grid sn-card-grid-featured">
            <article class="sn-feature-card sn-feature-yellow">
                <span class="sn-feature-index">01</span>
                <h3>Own your data</h3>
                <p>Clicks, destinations, and analytics stay on infrastructure you control.</p>
            </article>
            <article class="sn-feature-card sn-feature-mint">
                <span class="sn-feature-index">02</span>
                <h3>See what works</h3>
                <p>Real-time metrics, QR codes, branded domains, and useful click context come built in.</p>
            </article>
            <article class="sn-feature-card sn-feature-paper">
                <span class="sn-feature-index">03</span>
                <h3>Bring your own AI</h3>
                <p>Manage links and bio pages through the tools and AI clients you already trust.</p>
            </article>
        </div>
    </section>

    <article class="sn-panel sn-shortener">
        <header>
            <div>
                <p class="sn-kicker">01 / Create</p>
                <h2>Shorten a link</h2>
            </div>
            <small>Fast by default. Powerful when needed.</small>
        </header>
        <form hx-post="/" hx-target="#result" hx-swap="innerHTML">
            @Html.AntiForgeryToken()
            <label for="url">Long URL</label>
            <input type="url" name="url" id="url" placeholder="https://example.com/very/long/path" required>
            <details>
                <summary class="secondary">Add a custom code</summary>
                <div>
                    <label for="slug">Custom code <small>(optional)</small></label>
                    <input type="text" name="slug" id="slug" placeholder="my-custom-code"
                           pattern="[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}" maxlength="64">
                </div>
            </details>
            <div class="sn-form-actions">
                <small>Links are tracked in your current workspace.</small>
                <button type="submit">Shorten link</button>
            </div>
        </form>
        <div id="result"></div>
    </article>

    <section class="sn-callout" aria-labelledby="self-host-heading">
        <div>
            <p class="sn-kicker">Deploy / own / repeat</p>
            <h2 id="self-host-heading">Your links should not need a permission slip.</h2>
            <p>Run shortnr where your data belongs, connect a branded domain, and keep the workflow familiar from the first click to the last report.</p>
        </div>
        <div class="sn-callout-art" aria-hidden="true"><span>SELF</span><span>HOSTED</span><span>READY</span></div>
    </section>

    <section id="recent" aria-labelledby="recent-heading">
        <div class="sn-section-heading">
            <div>
                <p class="sn-kicker">02 / Recent output</p>
                <h2 id="recent-heading">Recent links</h2>
            </div>
            <small>Every short link is ready to inspect.</small>
        </div>
        <div class="sn-table-wrap">
            <table>
                <thead>
                    <tr>
                        <th>Short URL</th>
                        <th>Original</th>
                        <th>Clicks</th>
                        <th>QR</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var link in Model.RecentLinks)
                    {
                        <tr>
                            <td><a href="@link.DisplayUrl()" target="_blank">@link.DisplayText()</a></td>
                            <td>@link.LongUrl</td>
                            <td>@link.ClickCount</td>
                            <td>
                                <span class="qr-wrap">
                                    <button hx-get="/qr/@link.ShortCode" hx-target="closest .qr-wrap" hx-swap="innerHTML"
                                            class="sn-compact-button">QR</button>
                                </span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>
</div>
