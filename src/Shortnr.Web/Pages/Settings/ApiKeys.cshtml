@page "/settings/api-keys"
@model Shortnr.Web.Pages.Settings.ApiKeysModel
@{
    Layout = Model.IsHtmxRequest ? null : "_Layout";

    var scopes = new CheckboxGroupViewModel
    {
        Legend = "Scopes",
        InputName = "scope",
        Options = Shortnr.Web.Features.Authentication.ApiKeyScopes.All,
        IsChecked = s => Shortnr.Web.Features.Authentication.ApiKeyScopes.UiDefaults.Contains(s),
        Help = @<text>Keys are scoped to what they can do. The <code>mcp:*</code> scopes cover the MCP server; <code>links:*</code> cover the REST API.</text>
    };
}
<article>
    <header><h1>API keys</h1></header>
    <p>API keys authenticate requests to the <a href="/api/docs">shortnr API</a>. Send one as <code>Authorization: Bearer &lt;key&gt;</code>. Keys are shown only once, at creation time.</p>
    <form hx-post="/settings/api-keys" hx-target="#api-keys-list" hx-swap="innerHTML"
          hx-on::after-request="if (event.detail.successful) this.querySelector('input[name=label]').value = ''">
        @Html.AntiForgeryToken()
        <label for="api-key-label">Create an API key</label>
        <input type="text" name="label" id="api-key-label" placeholder="e.g. CI pipeline" required>
        <partial name="Shared/_CheckboxGroup" model="scopes" />
        <button type="submit">Create key</button>
    </form>
    <div id="api-keys-list">
        @await Html.PartialAsync("Shared/_ApiKeysList", Model)
    </div>
</article>
