@inject Shortnr.Web.Features.Theming.IThemeResolver ThemeResolver
@{
    var theme = await ThemeResolver.ResolveAsync((string?)ViewData["BioTheme"]);
    var title = (string?)ViewData["BioTitle"] ?? "shortnr";
}
@* Bio pages opt out of the app's dark scheme: the theme here is the page
   owner's choice, not the viewer's, and midnight is already the dark one.
   Pinning light also keeps the brutal theme's ink borders and hard shadows
   dark on a visitor whose OS is set to dark. *@
<!DOCTYPE html>
<html lang="en" data-bio-theme="@theme.Id" data-theme="@theme.Id" data-color-scheme="light">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@title</title>
    @await Html.PartialAsync("Shared/_SocialMeta")
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="/css/site.css">
    <script src="/lib/htmx.org/dist/htmx.min.js"></script>
    @* One shared palette per theme — the same file the redirect-preview
       layout links. Presets set --pv-* at :root under
       wwwroot/css/themes/preview-<id>.css; community themes set the same
       tokens scoped to [data-theme="id"] (the attribute above) via
       CommunityThemeCatalog's checksum-validated, disk-cached CSS. This
       layout used to bake its own --bio-* palette per preset and bridge
       community themes' --pv-* tokens into it with an extra <style> block;
       consuming --pv-* directly here removes both the duplication and the
       bridge. *@
    <link rel="stylesheet" href="/@theme.PreviewStylesheetPath">
    <style>
        /* All bio themes use brutalist styling: sharp corners, hard shadows,
           bold borders. Each theme has its own color palette (the --pv-*
           tokens linked above) but shares the same structural treatment
           (DSG-002 §5). */
        body {
            background: var(--pv-bg);
            color: var(--pv-fg);
            margin: 0;
            min-height: 100vh;
            font-family: var(--sn-font-body);
        }
        .bio-shell {
            display: flex;
            justify-content: center;
            padding: 3rem 1rem;
        }
        .bio-card {
            background: var(--pv-card);
            width: 100%;
            max-width: 480px;
            border: var(--sn-border-width-heavy) solid var(--pv-fg);
            border-radius: 0;
            padding: 2rem;
            box-shadow: var(--sn-shadow-offset-lg);
        }
        .bio-avatar {
            width: 88px;
            height: 88px;
            border: var(--sn-border-width-heavy) solid var(--pv-fg);
            border-radius: 0;
            object-fit: cover;
            display: block;
            margin: 0 auto 1rem;
        }
        .bio-name {
            text-align: center;
            font-family: var(--sn-font-display);
            font-size: var(--sn-text-h1);
            margin: 0 0 0.25rem;
            color: var(--pv-fg);
        }
        .bio-text {
            text-align: center;
            color: var(--pv-muted);
            margin: 0 0 1.5rem;
            white-space: pre-wrap;
        }
        .bio-links {
            list-style: none;
            padding: 0;
            margin: 0;
            display: grid;
            gap: 0.75rem;
        }
        .bio-links a {
            display: block;
            text-align: center;
            padding: 0.8rem 1rem;
            background: var(--pv-accent);
            color: var(--pv-accent-fg);
            text-decoration: none;
            border: var(--sn-border-width-heavy) solid var(--pv-fg);
            border-radius: 0;
            box-shadow: var(--sn-shadow-offset);
            font-weight: 700;
            transition: transform 0.1s, box-shadow 0.1s;
        }
        .bio-links a:hover {
            transform: translate(1px, 1px);
            box-shadow: 3px 3px 0 var(--pv-fg);
            color: var(--pv-accent-fg);
        }
        .bio-links a:active {
            transform: translate(3px, 3px);
            box-shadow: var(--sn-shadow-active);
        }
        .brand-footer {
            font-size: 0.75rem;
            color: var(--pv-muted);
            margin-top: 1.5rem;
        }
        .brand-footer a {
            color: var(--pv-muted);
            text-decoration: underline;
        }
        .bio-404 {
            text-align: center;
        }

        /* PRD-021: Social sections */
        .social-section {
            border-top: var(--sn-border-width) solid var(--pv-muted);
            padding-top: 1rem;
            margin-top: 1rem;
        }
        .social-header {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            margin-bottom: 0.75rem;
        }
        .social-avatar {
            width: 40px;
            height: 40px;
            border: var(--sn-border-width) solid var(--pv-fg);
            border-radius: 0;
            object-fit: cover;
        }
        .social-info {
            display: flex;
            flex-direction: column;
            gap: 0.125rem;
        }
        .social-platform {
            font-size: 0.75rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            color: var(--pv-accent);
        }
        .social-username {
            font-size: 0.875rem;
            color: var(--pv-fg);
        }
        .social-count {
            font-size: 0.75rem;
            color: var(--pv-muted);
        }
        .social-posts {
            display: grid;
            gap: 0.5rem;
        }
        .social-post {
            display: flex;
            gap: 0.5rem;
            padding: 0.5rem;
            border: var(--sn-border-width) solid var(--pv-muted);
            border-radius: 0;
            text-decoration: none;
            color: var(--pv-fg);
            transition: transform 0.1s;
        }
        .social-post:hover {
            transform: translate(1px, 1px);
            border-color: var(--pv-accent);
        }
        .social-post-media {
            width: 60px;
            height: 60px;
            object-fit: cover;
            border: var(--sn-border-width) solid var(--pv-muted);
            flex-shrink: 0;
        }
        .social-post-content {
            display: flex;
            flex-direction: column;
            gap: 0.25rem;
            min-width: 0;
            overflow: hidden;
        }
        .social-post-title {
            font-weight: 700;
            font-size: 0.875rem;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }
        .social-post-text {
            font-size: 0.75rem;
            color: var(--pv-muted);
            overflow: hidden;
            text-overflow: ellipsis;
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
        }
        .social-empty, .social-error, .social-loading {
            font-size: 0.875rem;
            color: var(--pv-muted);
            text-align: center;
            padding: 0.5rem;
        }
        .social-error {
            color: var(--sn-status-error-fg, #dc2626);
        }
    </style>
</head>

<body>
    <div class="bio-shell">
        @RenderBody()
    </div>
</body>

</html>
