@{
    var theme = ThemeCatalog.Resolve((string?)ViewData["BioTheme"]).Id;
    var title = (string?)ViewData["BioTitle"] ?? "shortnr";
}
@* Bio pages opt out of the app's dark scheme: the theme here is the page
   owner's choice, not the viewer's, and midnight is already the dark one.
   Pinning light also keeps the brutal theme's ink borders and hard shadows
   dark on a visitor whose OS is set to dark. *@
<!DOCTYPE html>
<html lang="en" data-bio-theme="@theme" data-color-scheme="light">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@title</title>
    @await Html.PartialAsync("Shared/_SocialMeta")
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="/css/site.css">
    <script src="/lib/htmx.org/dist/htmx.min.js"></script>
    <style>
        /* All bio themes use brutalist styling: sharp corners, hard shadows,
           bold borders. Each theme has its own color palette but shares the
           same structural treatment (DSG-002 §5). */
        [data-bio-theme="default"] {
            --bio-bg: var(--sn-paper);
            --bio-fg: var(--sn-ink);
            --bio-accent: var(--sn-accent);
            --bio-card: var(--sn-surface);
            --bio-muted: var(--sn-mid-gray);
            --bio-accent-fg: var(--sn-accent-ink);
        }
        [data-bio-theme="sunset"] {
            --bio-bg: #f9e3cf;
            --bio-fg: #5a3d2b;
            --bio-accent: #e85d3f;
            --bio-card: #fff7ef;
            --bio-muted: #9a6b4a;
            --bio-accent-fg: #ffffff;
        }
        [data-bio-theme="ocean"] {
            --bio-bg: #d9eaf5;
            --bio-fg: #1f3a5f;
            --bio-accent: #1d6fa5;
            --bio-card: #f2f9fd;
            --bio-muted: #4a6886;
            --bio-accent-fg: #ffffff;
        }
        [data-bio-theme="forest"] {
            --bio-bg: #dcead9;
            --bio-fg: #2f4a2e;
            --bio-accent: #3a7d3f;
            --bio-card: #f2f8f1;
            --bio-muted: #557754;
            --bio-accent-fg: #ffffff;
        }
        [data-bio-theme="midnight"] {
            --bio-bg: #1e2229;
            --bio-fg: #e6e9ef;
            --bio-accent: #7aa2f7;
            --bio-card: #2a303b;
            --bio-muted: #9aa4b2;
            --bio-accent-fg: #10141a;
        }
        /* Shared with the redirect-preview page's themes of the same name. */
        [data-bio-theme="minimal"] {
            --bio-bg: #faf9f7;
            --bio-fg: #37352f;
            --bio-accent: #2383e2;
            --bio-card: #ffffff;
            --bio-muted: #7d7a74;
            --bio-accent-fg: #ffffff;
        }
        [data-bio-theme="corporate"] {
            --bio-bg: #f5f6f8;
            --bio-fg: #1a1a2e;
            --bio-accent: #2563eb;
            --bio-card: #ffffff;
            --bio-muted: #64748b;
            --bio-accent-fg: #ffffff;
        }
        [data-bio-theme="dark"] {
            --bio-bg: #1a1b1e;
            --bio-fg: #e4e4e7;
            --bio-accent: #60a5fa;
            --bio-card: #27272a;
            --bio-muted: #a1a1aa;
            --bio-accent-fg: #1a1b1e;
        }

        body {
            background: var(--bio-bg);
            color: var(--bio-fg);
            margin: 0;
            min-height: 100vh;
            font-family: var(--sn-font-body);
        }
        .bio-shell {
            display: flex;
            justify-content: center;
            padding: 3rem 1rem;
        }
        .bio-card {
            background: var(--bio-card);
            width: 100%;
            max-width: 480px;
            border: var(--sn-border-width-heavy) solid var(--bio-fg);
            border-radius: 0;
            padding: 2rem;
            box-shadow: var(--sn-shadow-offset-lg);
        }
        .bio-avatar {
            width: 88px;
            height: 88px;
            border: var(--sn-border-width-heavy) solid var(--bio-fg);
            border-radius: 0;
            object-fit: cover;
            display: block;
            margin: 0 auto 1rem;
        }
        .bio-name {
            text-align: center;
            font-family: var(--sn-font-display);
            font-size: var(--sn-text-h1);
            margin: 0 0 0.25rem;
            color: var(--bio-fg);
        }
        .bio-text {
            text-align: center;
            color: var(--bio-muted);
            margin: 0 0 1.5rem;
            white-space: pre-wrap;
        }
        .bio-links {
            list-style: none;
            padding: 0;
            margin: 0;
            display: grid;
            gap: 0.75rem;
        }
        .bio-links a {
            display: block;
            text-align: center;
            padding: 0.8rem 1rem;
            background: var(--bio-accent);
            color: var(--bio-accent-fg);
            text-decoration: none;
            border: var(--sn-border-width-heavy) solid var(--bio-fg);
            border-radius: 0;
            box-shadow: var(--sn-shadow-offset);
            font-weight: 700;
            transition: transform 0.1s, box-shadow 0.1s;
        }
        .bio-links a:hover {
            transform: translate(1px, 1px);
            box-shadow: 3px 3px 0 var(--bio-fg);
            color: var(--bio-accent-fg);
        }
        .bio-links a:active {
            transform: translate(3px, 3px);
            box-shadow: var(--sn-shadow-active);
        }
        .brand-footer {
            font-size: 0.75rem;
            color: var(--bio-muted);
            margin-top: 1.5rem;
        }
        .brand-footer a {
            color: var(--bio-muted);
            text-decoration: underline;
        }
        .bio-404 {
            text-align: center;
        }

        /* PRD-021: Social sections */
        .social-section {
            border-top: var(--sn-border-width) solid var(--bio-muted);
            padding-top: 1rem;
            margin-top: 1rem;
        }
        .social-header {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            margin-bottom: 0.75rem;
        }
        .social-avatar {
            width: 40px;
            height: 40px;
            border: var(--sn-border-width) solid var(--bio-fg);
            border-radius: 0;
            object-fit: cover;
        }
        .social-info {
            display: flex;
            flex-direction: column;
            gap: 0.125rem;
        }
        .social-platform {
            font-size: 0.75rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            color: var(--bio-accent);
        }
        .social-username {
            font-size: 0.875rem;
            color: var(--bio-fg);
        }
        .social-count {
            font-size: 0.75rem;
            color: var(--bio-muted);
        }
        .social-posts {
            display: grid;
            gap: 0.5rem;
        }
        .social-post {
            display: flex;
            gap: 0.5rem;
            padding: 0.5rem;
            border: var(--sn-border-width) solid var(--bio-muted);
            border-radius: 0;
            text-decoration: none;
            color: var(--bio-fg);
            transition: transform 0.1s;
        }
        .social-post:hover {
            transform: translate(1px, 1px);
            border-color: var(--bio-accent);
        }
        .social-post-media {
            width: 60px;
            height: 60px;
            object-fit: cover;
            border: var(--sn-border-width) solid var(--bio-muted);
            flex-shrink: 0;
        }
        .social-post-content {
            display: flex;
            flex-direction: column;
            gap: 0.25rem;
            min-width: 0;
            overflow: hidden;
        }
        .social-post-title {
            font-weight: 700;
            font-size: 0.875rem;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }
        .social-post-text {
            font-size: 0.75rem;
            color: var(--bio-muted);
            overflow: hidden;
            text-overflow: ellipsis;
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
        }
        .social-empty, .social-error, .social-loading {
            font-size: 0.875rem;
            color: var(--bio-muted);
            text-align: center;
            padding: 0.5rem;
        }
        .social-error {
            color: var(--sn-status-error-fg, #dc2626);
        }
    </style>
</head>

<body>
    <div class="bio-shell">
        @RenderBody()
    </div>
</body>

</html>
