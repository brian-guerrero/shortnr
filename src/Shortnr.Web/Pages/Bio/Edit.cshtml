@page "/bio/edit"
@model Shortnr.Web.Pages.Bio.EditModel
@{
    Layout = Model.IsHtmxRequest ? null : "_Layout";
}
<article>
    <partial name="Shared/_PageHeader" model="@(new PageHeaderViewModel { Title = "Bio page", Workspace = Model.Workspace })" />
    <div id="bio-editor">
        @await Html.PartialAsync("Shared/_BioEditor", Model)
    </div>
</article>
