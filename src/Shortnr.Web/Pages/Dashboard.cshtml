@page
@model DashboardModel
@{
    ViewData["Title"] = "Dashboard";
}
<hgroup>
    <h1>Dashboard</h1>
    <p>Real-time metrics for your shortened links.</p>
</hgroup>

<div id="metrics-summary" hx-get="/dashboard" hx-trigger="load, every 5s" hx-swap="innerHTML">
    <article aria-busy="true"><p>Loading metrics...</p></article>
</div>

<article x-data="chartComponent()">
    <header><h3>Top Links</h3></header>
    <canvas id="topChart" height="100"></canvas>
</article>

<article>
    <header><h3>Search Links</h3></header>
    <input type="search" name="search" placeholder="Search by URL or short code..."
           hx-get="/dashboard"
           hx-trigger="keyup changed delay:200ms"
           hx-target="#search-results"
           hx-swap="innerHTML">
    <div id="search-results" hx-get="/dashboard" hx-trigger="load, every 10s" hx-swap="innerHTML">
        <article aria-busy="true"><p>Loading...</p></article>
    </div>
</article>

<article>
    <header><h3>Recent Clicks</h3></header>
    <div id="recent-clicks" hx-get="/dashboard" hx-trigger="load, every 5s" hx-swap="innerHTML">
        <article aria-busy="true"><p>Loading clicks...</p></article>
    </div>
</article>

@section Scripts {
<style>
.sortable th { cursor: pointer; user-select: none; }
.sortable th::after { content: ''; margin-left: 0.3em; }
.sortable th[data-sort="asc"]::after { content: '\25B2'; }
.sortable th[data-sort="desc"]::after { content: '\25BC'; }
</style>
<script>
document.addEventListener('click', e => {
    const th = e.target.closest('.sortable th');
    if (!th) return;
    const table = th.closest('.sortable');
    const tbody = table?.querySelector('tbody');
    if (!tbody) return;
    const headers = table.querySelectorAll('thead th');
    const colIdx = Array.from(headers).indexOf(th);
    if (colIdx < 0) return;

    const isAsc = th.dataset.sort === 'asc';
    headers.forEach(h => h.dataset.sort = '');
    th.dataset.sort = isAsc ? 'desc' : 'asc';

    const rows = Array.from(tbody.querySelectorAll('tr'));
    rows.sort((a, b) => {
        const aText = a.children[colIdx]?.textContent.trim() || '';
        const bText = b.children[colIdx]?.textContent.trim() || '';
        const aNum = parseFloat(aText.replace(/[,%]/g, ''));
        const bNum = parseFloat(bText.replace(/[,%]/g, ''));
        const cmp = !isNaN(aNum) && !isNaN(bNum)
            ? aNum - bNum
            : aText.localeCompare(bText, undefined, { numeric: true, sensitivity: 'base' });
        return isAsc ? -cmp : cmp;
    });

    rows.forEach(row => tbody.appendChild(row));
});
</script>
<script src="https://cdn.jsdelivr.net/npm/chart.js@@4/dist/chart.umd.min.js"></script>
<script>
function chartComponent() {
    let chart = null;
    return {
        async init() {
            await this.renderChart();
            setInterval(() => this.renderChart(), 5000);
        },
        async renderChart() {
            try {
                const resp = await fetch('/api/metrics');
                if (!resp.ok) throw new Error(`HTTP ${resp.status}`);
                const data = await resp.json();
                const canvas = document.getElementById('topChart');
                if (!canvas) return;
                const labels = data.topLinks.map(l => l.shortCode);
                const values = data.topLinks.map(l => l.clickCount);

                if (chart) {
                    chart.data.labels = labels;
                    chart.data.datasets[0].data = values;
                    chart.update();
                } else {
                    chart = new Chart(canvas, {
                        type: 'bar',
                        data: {
                            labels,
                            datasets: [{
                                label: 'Clicks',
                                data: values,
                                backgroundColor: 'rgba(54, 162, 235, 0.6)',
                                borderColor: 'rgba(54, 162, 235, 1)',
                                borderWidth: 1
                            }]
                        },
                        options: {
                            responsive: true,
                            indexAxis: 'y',
                            plugins: { legend: { display: false } },
                            scales: {
                                x: { beginAtZero: true, ticks: { precision: 0 } }
                            }
                        }
                    });
                }
            } catch (e) {
                console.error('chart render failed:', e);
            }
        }
    };
}
</script>
<script src="https://cdn.jsdelivr.net/npm/alpinejs@@3/dist/cdn.min.js"></script>
}
