@page
@model DashboardModel
@{
    ViewData["Title"] = "Dashboard";
}
<partial name="Shared/_PageHeader" model="@(new PageHeaderViewModel { Title = "Dashboard", Subtitle = "Real-time metrics for your shortened links.", Workspace = Model.Workspace })" />

<div sse-connect="/api/events">
    <div id="dashboard-data" hx-get="/dashboard" hx-trigger="load, sse:data-update" hx-swap="innerHTML">
        <article aria-busy="true"><p>Loading dashboard...</p></article>
    </div>

    <div class="grid">
        <article x-data="chartComponent()">
            <header><h3>Top Links</h3></header>
            <canvas id="topChart" height="100"></canvas>
        </article>
        <article x-data="chartComponent()">
            <header><h3>Countries</h3></header>
            <canvas id="countryChart" height="100"></canvas>
        </article>
    </div>

    <article>
        <header><h3>Search Links</h3></header>
        <div class="grid">
            <input type="search" id="search-input" name="search" placeholder="Search by URL, short code or domain..."
                   hx-get="/dashboard"
                   hx-trigger="keyup changed delay:200ms"
                   hx-target="#search-results"
                   hx-swap="innerHTML"
                   hx-include="#domain-filter, #status-filter">
            <select id="domain-filter" name="domain"
                    hx-get="/dashboard"
                    hx-trigger="change"
                    hx-target="#search-results"
                    hx-swap="innerHTML"
                    hx-include="#search-input, #status-filter">
                @foreach (var d in Model.DomainOptions)
                {
                    <option value="@d">@d</option>
                }
            </select>
            <select id="status-filter" name="status"
                    hx-get="/dashboard"
                    hx-trigger="change"
                    hx-target="#search-results"
                    hx-swap="innerHTML"
                    hx-include="#search-input, #domain-filter">
                <option value="active">Active</option>
                <option value="all">All</option>
                <option value="archived">Archived</option>
            </select>
        </div>
        <div id="link-edit-region"></div>
        <div id="search-results" hx-get="/dashboard" hx-trigger="load" hx-swap="innerHTML">
            <article aria-busy="true"><p>Loading...</p></article>
        </div>
    </article>

    <article>
        <header><h3>Recent Clicks</h3></header>
        <div id="recent-clicks">
            <article aria-busy="true"><p>Loading clicks...</p></article>
        </div>
    </article>
</div>

@section Scripts {
<script src="/lib/chartjs/dist/chart.umd.min.js"></script>
<script>
// Chart colours come from the design tokens rather than Chart.js defaults,
// so the charts stay in the same palette as the cards and badges around
// them (DSG-002 §1, flagged in DSG-003 as JS-embedded colour that a
// stylesheet swap alone would miss).
const TOKEN = (name, fallback) =>
    getComputedStyle(document.documentElement).getPropertyValue(name).trim() || fallback;

// Mixes two #rrggbb tokens, so the two extra series the geo chart can need
// (it shows up to ten countries) are still derived from the token set
// rather than reintroducing off-palette colours.
const mix = (from, to, t) => {
    const parse = (h) => [1, 3, 5].map(i => parseInt(h.slice(i, i + 2), 16));
    const [r1, g1, b1] = parse(from), [r2, g2, b2] = parse(to);
    const step = (a, b) => Math.round(a + (b - a) * t).toString(16).padStart(2, '0');
    return '#' + step(r1, r2) + step(g1, g2) + step(b1, b2);
};

// Resolved per render, not once at load: the tokens move when the colour
// scheme changes, and Chart.js bakes colours in at construction time.
function palette() {
    const ink = TOKEN('--sn-ink', '#111111');
    const paper = TOKEN('--sn-paper', '#faf9f5');
    const accent = TOKEN('--sn-accent', '#ffd23f');
    const violet = TOKEN('--sn-accent-secondary', '#7c5cff');

    // Qualitative series: the accent leads, violet anchors second, then the
    // status tokens and the structural neutrals. Ink borders keep adjacent
    // slices legible the same way they separate table cells.
    const colors = [
        accent,
        violet,
        TOKEN('--sn-status-info', '#6ec1ff'),
        TOKEN('--sn-status-success', '#3ddc84'),
        TOKEN('--sn-status-error', '#ff4d4d'),
        ink,
        TOKEN('--sn-mid-gray', '#8a8578'),
        TOKEN('--sn-status-neutral', '#e8e4d9'),
        mix(accent, ink, 0.45),
        mix(violet, paper, 0.5)
    ];

    return {
        ink,
        accent,
        series: (count) => Array.from({ length: count }, (_, i) => colors[i % colors.length])
    };
}

(function() {
    var rc = document.getElementById('recent-clicks');
    if (!rc) return;

    rc.addEventListener('click', function(e) {
        var row = e.target.closest('tr:not(.detail-row)');
        if (!row) return;
        var detail = row.nextElementSibling;
        if (!detail || !detail.classList.contains('detail-row')) return;

        var prevOpen = rc.querySelector('.detail-row[style*="table-row"]');
        if (prevOpen && prevOpen !== detail) prevOpen.style.display = 'none';

        var isOpen = detail.style.display === 'table-row';
        detail.style.display = isOpen ? 'none' : 'table-row';
        rc.dataset.expandedId = isOpen ? '' : (detail.getAttribute('data-click-id') || '');
    });

    function restoreExpanded() {
        var id = rc.dataset.expandedId;
        if (!id) return;
        var detail = rc.querySelector('.detail-row[data-click-id="' + id + '"]');
        if (detail) detail.style.display = 'table-row';
    }

    document.body.addEventListener('htmx:afterSwap', function(e) {
        if (e.detail.target.id !== 'recent-clicks') return;
        restoreExpanded();
    });
    document.body.addEventListener('htmx:oobAfterSwap', function(e) {
        if (e.detail.target.id !== 'recent-clicks') return;
        restoreExpanded();
    });
})();

function chartComponent() {
    let topChart = null;
    let countryChart = null;
    return {
        init() {
            this.renderCharts();
            document.body.addEventListener('htmx:afterSwap', (e) => {
                if (e.detail.target.id === 'dashboard-data') this.renderCharts();
            });
            // Colours are baked into the chart instances, so a scheme change
            // means tearing them down and rebuilding against the new tokens.
            document.body.addEventListener('sn:color-scheme-change', () => {
                if (topChart) { topChart.destroy(); topChart = null; }
                if (countryChart) { countryChart.destroy(); countryChart = null; }
                this.renderCharts();
            });
        },
        renderCharts() {
            var el = document.getElementById('chart-data');
            if (!el) return;
            Chart.defaults.font.family = TOKEN('--sn-font-body', 'system-ui, sans-serif');
            Chart.defaults.color = palette().ink;
            try {
                var data = JSON.parse(el.textContent);
                this.renderTopChart(data);
                this.renderCountryChart(data);
            } catch (e) {
                console.error('chart render failed:', e);
            }
        },
        renderTopChart(data) {
            const canvas = document.getElementById('topChart');
            if (!canvas) return;
            const labels = data.topLinks.map(l => l.shortCode);
            const values = data.topLinks.map(l => l.clickCount);

            if (topChart) {
                topChart.data.labels = labels;
                topChart.data.datasets[0].data = values;
                topChart.update();
            } else if (labels.length > 0) {
                const p = palette();
                topChart = new Chart(canvas, {
                    type: 'bar',
                    data: {
                        labels,
                        datasets: [{
                            label: 'Clicks',
                            data: values,
                            backgroundColor: p.accent,
                            borderColor: p.ink,
                            borderWidth: 2
                        }]
                    },
                    options: {
                        responsive: true,
                        indexAxis: 'y',
                        plugins: { legend: { display: false } },
                        scales: {
                            x: { beginAtZero: true, ticks: { precision: 0 } }
                        }
                    }
                });
            }
        },
        renderCountryChart(data) {
            const canvas = document.getElementById('countryChart');
            if (!canvas) return;
            const labels = data.countryBreakdown.map(c => c.countryCode || 'Unknown');
            const values = data.countryBreakdown.map(c => c.count);

            if (countryChart) {
                countryChart.data.labels = labels;
                countryChart.data.datasets[0].data = values;
                countryChart.update();
            } else if (labels.length > 0) {
                const p = palette();
                countryChart = new Chart(canvas, {
                    type: 'doughnut',
                    data: {
                        labels,
                        datasets: [{
                            data: values,
                            backgroundColor: p.series(labels.length),
                            borderColor: p.ink,
                            borderWidth: 2
                        }]
                    },
                    options: {
                        responsive: true,
                        plugins: {
                            legend: { position: 'right' }
                        }
                    }
                });
            }
        }
    };
}
</script>
<script src="/lib/alpinejs/dist/cdn.min.js"></script>
}