@page
@model DashboardModel
@{
    ViewData["Title"] = "Dashboard";
}
<hgroup>
    <h1>Dashboard</h1>
    <p>Real-time metrics for your shortened links.</p>
</hgroup>

<div id="metrics-summary" hx-get="/dashboard" hx-trigger="load, every 5s" hx-swap="innerHTML">
    <article aria-busy="true"><p>Loading metrics...</p></article>
</div>

<article x-data="chartComponent()">
    <header><h3>Top Links</h3></header>
    <canvas id="topChart" height="100"></canvas>
</article>

<article>
    <header><h3>Search Links</h3></header>
    <input type="search" name="search" placeholder="Search by URL or short code..."
           hx-get="/dashboard"
           hx-trigger="keyup changed delay:200ms"
           hx-target="#search-results"
           hx-swap="innerHTML">
    <div id="search-results" hx-get="/dashboard" hx-trigger="load, every 10s" hx-swap="innerHTML">
        <article aria-busy="true"><p>Loading...</p></article>
    </div>
</article>

@section Scripts {
<script src="https://cdn.jsdelivr.net/npm/chart.js@@4/dist/chart.umd.min.js"></script>
<script>
function chartComponent() {
    let chart = null;
    return {
        async init() {
            await this.renderChart();
            setInterval(() => this.renderChart(), 5000);
        },
        async renderChart() {
            try {
                const resp = await fetch('/api/metrics');
                if (!resp.ok) throw new Error(`HTTP ${resp.status}`);
                const data = await resp.json();
                const canvas = document.getElementById('topChart');
                if (!canvas) return;
                const labels = data.topLinks.map(l => l.shortCode);
                const values = data.topLinks.map(l => l.clickCount);

                if (chart) {
                    chart.data.labels = labels;
                    chart.data.datasets[0].data = values;
                    chart.update();
                } else {
                    chart = new Chart(canvas, {
                        type: 'bar',
                        data: {
                            labels,
                            datasets: [{
                                label: 'Clicks',
                                data: values,
                                backgroundColor: 'rgba(54, 162, 235, 0.6)',
                                borderColor: 'rgba(54, 162, 235, 1)',
                                borderWidth: 1
                            }]
                        },
                        options: {
                            responsive: true,
                            indexAxis: 'y',
                            plugins: { legend: { display: false } },
                            scales: {
                                x: { beginAtZero: true, ticks: { precision: 0 } }
                            }
                        }
                    });
                }
            } catch (e) {
                console.error('chart render failed:', e);
            }
        }
    };
}
</script>
<script src="https://cdn.jsdelivr.net/npm/alpinejs@@3/dist/cdn.min.js"></script>
}
