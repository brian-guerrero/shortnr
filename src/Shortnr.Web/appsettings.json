{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Seo": {
    "SiteName": "shortnr",
    "Description": "shortnr is a self-hosted URL shortener with a dashboard, link-in-bio pages, branded domains, and a REST API.",
    "Author": "shortnr",
    "Locale": "en_US"
  },
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=shortnr.db"
  },
  "GeoIp": {
    "DatabasePath": "",
    "MaxMindAccountId": "",
    "MaxMindLicenseKey": ""
  },
  "RateLimiting": {
    "TrustForwardedFor": false,
    "Shorten": {
      "PerMinute": 10,
      "PerDay": 200
    },
    "Redirect": {
      "PerMinute": 300,
      "PerDay": 10000
    }
  },
  "Authentication": {
    "Enabled": true,
    "Oidc": {
      "Authority": "http://localhost:5556/dex",
      "ClientId": "shortnr-web",
      "ClientSecret": "dev-only-not-a-real-secret",
      "CallbackPath": "/signin-oidc"
    }
  },
  "OAuth": {
    "Issuer": "http://localhost:5156",
    "Resource": "http://localhost:5156/mcp",
    "AccessTokenLifetimeMinutes": 60,
    "RefreshTokenLifetimeDays": 14
  }
}
