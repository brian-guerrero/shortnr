{
  "version": "3.0",
  "defaultProvider": "jsdelivr",
  "defaultDestination": "wwwroot/lib",
  "libraries": [
    {
      "library": "@picocss/pico@2.1.1",
      "destination": "wwwroot/lib/pico",
      "files": [
        "css/pico.min.css",
        "css/pico.colors.min.css"
      ]
    },
    {
      "library": "chart.js@4.4.9",
      "destination": "wwwroot/lib/chartjs",
      "files": [
        "dist/chart.umd.min.js"
      ]
    },
    {
      "library": "alpinejs@3.14.9",
      "destination": "wwwroot/lib/alpinejs",
      "files": [
        "dist/cdn.min.js"
      ]
    },
    {
      "provider": "unpkg",
      "library": "htmx.org@2.0.4",
      "destination": "wwwroot/lib/htmx",
      "files": [
        "dist/htmx.min.js"
      ]
    },
    {
      "library": "htmx-ext-sse@2.2.4",
      "destination": "wwwroot/lib/htmx-ext-sse",
      "files": [
        "dist/sse.min.js"
      ]
    }
  ]
}