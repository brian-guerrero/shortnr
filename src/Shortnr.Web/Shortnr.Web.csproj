<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\Shortnr.Data\Shortnr.Data.csproj" />
    <!-- Not referenced directly in code, but required so Shortnr.Data.Postgres.dll is deployed
         to the app's output folder, since DatabaseProviderHelper resolves it by assembly name
         (MigrationsAssembly("Shortnr.Data.Postgres")) at runtime. -->
    <ProjectReference Include="..\Shortnr.Data.Postgres\Shortnr.Data.Postgres.csproj" />
    <ProjectReference Include="..\Shortnr.ServiceDefaults\Shortnr.ServiceDefaults.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Design-time only, needed so `dotnet ef` tooling can use this project as the
         startup project when scaffolding Postgres migrations
         (project src\Shortnr.Data.Postgres\Shortnr.Data.Postgres.csproj). -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.10">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="DnsClient" Version="1.8.0" />
    <PackageReference Include="MailKit" Version="4.17.0" />
    <PackageReference Include="MaxMind.GeoIP2" Version="6.1.0" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.10" />
    <PackageReference Include="Microsoft.OpenApi" Version="2.7.5" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="2.0.0" />
    <PackageReference Include="OpenIddict.AspNetCore" Version="7.6.0" />
    <PackageReference Include="OpenIddict.EntityFrameworkCore" Version="7.6.0" />
    <PackageReference Include="QRCoder" Version="1.8.0" />
    <PackageReference Include="Microsoft.Web.LibraryManager.Build" Version="3.0.114" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="10.0.10" />
    <PackageReference Include="Scalar.AspNetCore" Version="2.16.17" />
    <PackageReference Include="System.Threading.RateLimiting" Version="10.0.10" />
    <PackageReference Include="uaParser.Net" Version="1.0.1" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

</Project>
