<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\Shortnr.Data\Shortnr.Data.csproj" />
    <!-- Not referenced directly in code, but required so Shortnr.Data.Postgres.dll is deployed
         to the app's output folder, since DatabaseProviderHelper resolves it by assembly name
         (MigrationsAssembly("Shortnr.Data.Postgres")) at runtime. -->
    <ProjectReference Include="..\Shortnr.Data.Postgres\Shortnr.Data.Postgres.csproj" />
    <ProjectReference Include="..\Shortnr.ServiceDefaults\Shortnr.ServiceDefaults.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Design-time only, needed so `dotnet ef` tooling can use this project as the
         startup project when scaffolding Postgres migrations
         (project src\Shortnr.Data.Postgres\Shortnr.Data.Postgres.csproj). -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="DnsClient" />
    <PackageReference Include="MailKit" />
    <PackageReference Include="MaxMind.GeoIP2" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <!-- PRD-023 LLM layer: Microsoft.Extensions.AI's IChatClient is the transport abstraction
         used by Features/Insights/Llm; Microsoft.Extensions.AI.OpenAI bridges the OpenAI SDK
         (used for both the OpenAI and OpenRouter providers, which are OpenAI-wire-compatible)
         to IChatClient; CommunityToolkit.Aspire.OllamaSharp provides OllamaApiClient + its
         IChatClient adapter for the Ollama provider (paired with
         CommunityToolkit.Aspire.Hosting.Ollama in Shortnr.AppHost.csproj for local dev). -->
    <PackageReference Include="Microsoft.Extensions.AI" />
    <PackageReference Include="Microsoft.Extensions.AI.OpenAI" />
    <PackageReference Include="CommunityToolkit.Aspire.OllamaSharp" />
    <PackageReference Include="Microsoft.OpenApi" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" />
    <PackageReference Include="OpenIddict.AspNetCore" />
    <PackageReference Include="OpenIddict.EntityFrameworkCore" />
    <PackageReference Include="QRCoder" />
    <PackageReference Include="Microsoft.Web.LibraryManager.Build" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" />
    <PackageReference Include="Scalar.AspNetCore" />
    <PackageReference Include="System.Threading.RateLimiting" />
    <PackageReference Include="uaParser.Net" />
  </ItemGroup>

</Project>
